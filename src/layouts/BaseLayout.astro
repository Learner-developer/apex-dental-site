---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { clinicName, seo } from '../data/site';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Header from '../components/Header.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = seo.title, description = seo.description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={seo.ogDescription} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="pb-20 md:pb-0">
    <AnnouncementBar />
    <Header />
    <main>
      <slot />
    </main>
    <StickyMobileCTA />
  </body>
</html>

<script>
  import Alpine from 'alpinejs';
  window.Alpine = Alpine;
  Alpine.start();
</script>

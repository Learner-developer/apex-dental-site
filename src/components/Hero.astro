---
import { Image } from 'astro:assets';
import { heroBanners } from '../data/hero-banners';
---

<section
  class="hero-carousel relative min-h-[88vh] overflow-hidden"
  x-data={`{
    active: 0,
    total: ${heroBanners.length},
    timer: null,
    go(dir) {
      this.active = (this.active + dir + this.total) % this.total;
      this.resetTimer();
    },
    goTo(index) {
      this.active = index;
      this.resetTimer();
    },
    resetTimer() {
      clearInterval(this.timer);
      this.timer = setInterval(() => { this.active = (this.active + 1) % this.total; }, 7000);
    }
  }`}
  x-init="resetTimer()"
  @mouseenter="clearInterval(timer)"
  @mouseleave="resetTimer()"
  @focusin="clearInterval(timer)"
  @focusout="resetTimer()"
  aria-roledescription="carousel"
  aria-label="Clinic highlights"
>
  {
    heroBanners.map((banner, index) => (
      <div
        class="absolute inset-0"
        x-show={`active === ${index}`}
        x-transition:enter="transition ease-out duration-700"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="transition ease-in duration-500"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        role="group"
        aria-roledescription="slide"
        aria-label={`Slide ${index + 1} of ${heroBanners.length}: ${banner.headline}`}
      >
        <Image
          src={banner.image}
          alt={banner.imageAlt}
          class="absolute inset-0 h-full w-full object-cover object-center"
          widths={[640, 960, 1280, 1600, 1920]}
          sizes="100vw"
          loading={index === 0 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : 'auto'}
        />
        <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/85 to-ink/25 lg:to-ink/10"></div>
      </div>
    ))
  }

  <div
    class="blob-shape blob-float pointer-events-none absolute -left-24 top-24 z-[1] h-64 w-64 bg-cta/25 blur-2xl lg:left-[18%] lg:top-32"
    aria-hidden="true"
  ></div>
  <div
    class="blob-shape-alt blob-float-slow pointer-events-none absolute bottom-16 left-1/3 z-[1] hidden h-72 w-72 bg-brand/30 blur-3xl lg:block"
    aria-hidden="true"
  ></div>

  <div class="section-shell relative z-10 flex min-h-[88vh] items-end pb-20 pt-36 md:items-center md:pb-24 md:pt-28">
    {
      heroBanners.map((banner, index) => (
        <div
          class="max-w-xl text-white lg:max-w-2xl"
          x-show={`active === ${index}`}
          x-transition:enter="transition ease-out duration-500 delay-100"
          x-transition:enter-start="opacity-0 translate-y-3"
          x-transition:enter-end="opacity-100 translate-y-0"
        >
          <p class="eyebrow text-highlight">{banner.eyebrow}</p>
          <h1
            class="font-display text-[clamp(2.25rem,1.2rem+4vw,4.25rem)] font-semibold leading-[1.1] tracking-[-0.03em] text-balance"
          >
            {banner.headline}
          </h1>
          <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/85">{banner.subhead}</p>
          {
            banner.showRatingBadge && (
              <p class="mt-5 inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-sm font-medium text-white backdrop-blur transition duration-300 hover:border-[#1de1da]/60 hover:bg-white/20">
                <span class="text-[#f9f871]">★</span> 4.97 · 482 Google Reviews
              </p>
            )
          }
          <div class="mt-8 flex flex-wrap gap-3">
            {
              banner.ctas.map((cta) => (
                <a
                  href={cta.href}
                  target={cta.external ? '_blank' : undefined}
                  rel={cta.external ? 'noopener noreferrer' : undefined}
                  class:list={[
                    cta.variant === 'ghost' ? 'btn-ghost' : 'btn-cta btn-cta-primary',
                  ]}
                >
                  {cta.label}
                </a>
              ))
            }
          </div>
        </div>
      ))
    }
  </div>

  <aside
    class="card-hover absolute bottom-8 right-4 z-10 hidden max-w-[17rem] rounded-[2rem] bg-cream p-6 shadow-[var(--shadow-lift)] md:right-8 lg:block border border-ink/5"
    aria-label="Google rating"
  >
    <div class="flex items-start justify-between gap-3">
      <p class="font-display text-5xl leading-none text-ink">4.97</p>
      <span class="inline-flex rounded-full bg-ink px-3 py-1 text-sm font-semibold text-[#f9f871]">★</span>
    </div>
    <p class="mt-3 text-sm font-medium text-ink/70">482 Google Reviews</p>
    <span class="mt-4 block h-1.5 w-16 rounded-full bg-[#1de1da]" aria-hidden="true"></span>
  </aside>

  <div class="absolute bottom-6 left-0 right-0 z-10 flex items-center justify-center gap-4 px-4 lg:bottom-8">
    <button
      type="button"
      class="hero-nav-btn hidden md:inline-flex"
      @click="go(-1)"
      aria-label="Previous slide"
    >
      ←
    </button>
    <div class="flex items-center gap-2" role="tablist" aria-label="Hero slides">
      {
        heroBanners.map((banner, index) => (
          <button
            type="button"
            class="hero-dot"
            x-bind:class={`active === ${index} ? 'is-active' : ''`}
            @click={`goTo(${index})`}
            role="tab"
            x-bind:aria-selected={`active === ${index} ? 'true' : 'false'`}
            aria-label={`Show slide: ${banner.headline}`}
          ></button>
        ))
      }
    </div>
    <button
      type="button"
      class="hero-nav-btn hidden md:inline-flex"
      @click="go(1)"
      aria-label="Next slide"
    >
      →
    </button>
  </div>
</section>

<style>
  .hero-nav-btn {
    display: inline-flex;
    height: 2.5rem;
    width: 2.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid rgb(255 255 255 / 0.3);
    background: rgb(21 21 19 / 0.5);
    font-size: 0.875rem;
    color: white;
    backdrop-filter: blur(8px);
    transition: all 0.2s ease-out;
  }

  .hero-nav-btn:hover {
    background: rgb(21 21 19 / 0.85);
    border-color: #1de1da;
    transform: scale(1.08);
    box-shadow: 0 0 14px rgba(29, 225, 218, 0.4);
  }

  .hero-nav-btn:active {
    transform: scale(0.95);
  }

  .hero-nav-btn:focus-visible {
    outline: 2px solid #1de1da;
    outline-offset: 2px;
  }

  .hero-dot {
    height: 0.5rem;
    width: 0.5rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.45);
    transition: all 0.25s ease-out;
    cursor: pointer;
  }

  .hero-dot:hover {
    background: rgb(255 255 255 / 0.85);
  }

  .hero-dot.is-active {
    width: 1.75rem;
    background: #1de1da;
    box-shadow: 0 0 10px rgba(29, 225, 218, 0.6);
  }
</style>

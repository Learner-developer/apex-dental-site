---
import { Image } from 'astro:assets';
import { heroBanners } from '../data/hero-banners';

const bannerShades = [
  // Slide 0: General / Trust - Deep Midnight Teal
  'bg-gradient-to-t from-black/85 via-black/40 via-60% to-transparent md:bg-gradient-to-r md:from-[#042f2e]/95 md:via-[#042f2e]/80 md:via-45% md:to-transparent',
  // Slide 1: Orthodontics & Braces - Deep Velvet Purple (#c084fc)
  'bg-gradient-to-t from-black/85 via-black/40 via-60% to-transparent md:bg-gradient-to-r md:from-[#2e1065]/95 md:via-[#2e1065]/80 md:via-45% md:to-transparent',
  // Slide 2: Painless Root Canal - Deep Warm Amber (#f59e0b)
  'bg-gradient-to-t from-black/85 via-black/40 via-60% to-transparent md:bg-gradient-to-r md:from-[#451a03]/95 md:via-[#451a03]/80 md:via-45% md:to-transparent',
  // Slide 3: Implants & Restorative (Missing Teeth) - Deep Crimson Rose (#fb7185)
  'bg-gradient-to-t from-black/85 via-black/40 via-60% to-transparent md:bg-gradient-to-r md:from-[#4c0519]/95 md:via-[#4c0519]/80 md:via-45% md:to-transparent',
  // Slide 4: Family & Pediatric - Deep Ocean Sky (#38bdf8)
  'bg-gradient-to-t from-black/85 via-black/40 via-60% to-transparent md:bg-gradient-to-r md:from-[#0c4a6e]/95 md:via-[#0c4a6e]/80 md:via-45% md:to-transparent',
];

const eyebrowColors = ['text-[#38bdf8]', 'text-[#c084fc]', 'text-[#f59e0b]', 'text-[#fb7185]', 'text-[#38bdf8]'];
---

<section
  class="hero-carousel relative min-h-[88vh] overflow-hidden"
  x-data={`{
    active: 0,
    total: ${heroBanners.length},
    timer: null,
    touchStartX: 0,
    touchEndX: 0,
    go(dir) {
      this.active = (this.active + dir + this.total) % this.total;
      this.resetTimer();
    },
    goTo(index) {
      this.active = index;
      this.resetTimer();
    },
    resetTimer() {
      clearInterval(this.timer);
      this.timer = setInterval(() => { this.active = (this.active + 1) % this.total; }, 3000);
    },
    handleTouchStart(e) {
      this.touchStartX = e.changedTouches[0].screenX;
      clearInterval(this.timer);
    },
    handleTouchEnd(e) {
      this.touchEndX = e.changedTouches[0].screenX;
      if (this.touchStartX - this.touchEndX > 45) {
        this.go(1);
      } else if (this.touchEndX - this.touchStartX > 45) {
        this.go(-1);
      } else {
        this.resetTimer();
      }
    }
  }`}
  x-init="resetTimer()"
  @mouseenter="clearInterval(timer)"
  @mouseleave="resetTimer()"
  @focusin="clearInterval(timer)"
  @focusout="resetTimer()"
  @touchstart.passive="handleTouchStart($event)"
  @touchend.passive="handleTouchEnd($event)"
  aria-roledescription="carousel"
  aria-label="Clinic highlights"
>
  {
    heroBanners.map((banner, index) => (
      <div
        class="absolute inset-0"
        x-show={`active === ${index}`}
        x-transition:enter="transition ease-out duration-700"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="transition ease-in duration-500"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        role="group"
        aria-roledescription="slide"
        aria-label={`Slide ${index + 1} of ${heroBanners.length}: ${banner.headline}`}
      >
        <Image
          src={banner.image}
          alt={banner.imageAlt}
          class="absolute inset-0 h-full w-full object-cover object-right md:object-center"
          widths={[640, 960, 1280, 1600, 1920]}
          sizes="100vw"
          loading={index === 0 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : 'auto'}
        />
        <div class:list={['absolute inset-0', bannerShades[index % bannerShades.length]]}></div>
      </div>
    ))
  }

  <div
    class="blob-shape blob-float pointer-events-none absolute -left-24 top-24 z-[1] hidden h-64 w-64 bg-cta/25 blur-2xl lg:left-[18%] lg:top-32 lg:block"
    aria-hidden="true"
  ></div>
  <div
    class="blob-shape-alt blob-float-slow pointer-events-none absolute bottom-16 left-1/3 z-[1] hidden h-72 w-72 bg-[#38bdf8]/20 blur-3xl lg:block"
    aria-hidden="true"
  ></div>

  <div class="section-shell relative z-10 flex min-h-[88vh] items-end pb-24 pt-32 sm:pb-20 sm:pt-36 md:items-center md:pb-24 md:pt-28">
    {
      heroBanners.map((banner, index) => (
        <div
          class="max-w-xl text-white lg:max-w-2xl"
          x-show={`active === ${index}`}
          x-transition:enter="transition ease-out duration-500 delay-100"
          x-transition:enter-start="opacity-0 translate-y-3"
          x-transition:enter-end="opacity-100 translate-y-0"
        >
          <p class:list={['eyebrow', eyebrowColors[index % eyebrowColors.length]]}>{banner.eyebrow}</p>
          <h1 class="hero-title">
            {banner.headline}
          </h1>
          <p class="mt-4 max-w-xl text-base sm:text-lg leading-[1.65] text-white/90 text-pretty">{banner.subhead}</p>
          {
            banner.showRatingBadge && (
              <p class="mt-5 inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-xs sm:text-sm font-semibold tracking-wide text-white backdrop-blur transition duration-300 hover:border-[#38bdf8]/60 hover:bg-white/20">
                <span class="text-[#f59e0b]">★</span> <span class="tabular-nums">4.97</span> · <span class="tabular-nums">482</span> Google Reviews
              </p>
            )
          }
          <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            {
              banner.ctas.map((cta) => {
                const isPhone = cta.href.startsWith('tel:');
                const isWhatsApp = cta.href.includes('wa.me');
                const eventName = isWhatsApp ? 'click_whatsapp' : isPhone ? 'click_phone' : 'click_hero_cta';

                return (
                  <a
                    href={cta.href}
                    target={cta.external ? '_blank' : undefined}
                    rel={cta.external ? 'noopener noreferrer' : undefined}
                    data-analytics-event={eventName}
                    data-analytics-location="hero"
                    data-analytics-label={cta.label}
                    class:list={[
                      'w-full sm:w-auto text-center justify-center',
                      cta.variant === 'ghost' ? 'btn-call' : 'btn-cta',
                    ]}
                  >
                    {isPhone && (
                      <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                      </svg>
                    )}
                    {isWhatsApp && (
                      <svg class="h-4 w-4 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                      </svg>
                    )}
                    <span>{cta.label}</span>
                  </a>
                );
              })
            }
          </div>
        </div>
      ))
    }
  </div>

  <!-- Navigation Arrows and Dots -->
  <div class="section-shell pointer-events-none absolute inset-x-0 bottom-8 z-30 flex items-center justify-between">
    <div class="pointer-events-auto flex items-center gap-2">
      <button
        type="button"
        class="hero-nav-btn flex h-11 w-11 items-center justify-center cursor-pointer"
        aria-label="Previous slide"
        @click="go(-1)"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>
      <button
        type="button"
        class="hero-nav-btn flex h-11 w-11 items-center justify-center cursor-pointer"
        aria-label="Next slide"
        @click="go(1)"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
    </div>

    <!-- Dots -->
    <div class="pointer-events-auto flex items-center gap-2" role="tablist" aria-label="Hero slider pagination">
      {
        heroBanners.map((banner, index) => (
          <button
            type="button"
            class="hero-dot"
            x-bind:class={`active === ${index} ? 'is-active' : ''`}
            @click={`goTo(${index})`}
            role="tab"
            x-bind:aria-selected={`active === ${index} ? 'true' : 'false'`}
            aria-label={`Go to slide ${index + 1}: ${banner.headline}`}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero-nav-btn {
    border-radius: 9999px;
    border: 1px solid rgb(255 255 255 / 0.3);
    background: rgb(21 21 19 / 0.5);
    color: white;
    backdrop-filter: blur(8px);
    transition: all 0.2s ease-out;
  }

  .hero-nav-btn:hover {
    background: rgb(21 21 19 / 0.85);
    border-color: #38bdf8;
    transform: scale(1.08);
    box-shadow: 0 0 14px rgba(56, 189, 248, 0.4);
  }

  .hero-nav-btn:active {
    transform: scale(0.95);
  }

  .hero-nav-btn:focus-visible {
    outline: 2px solid #38bdf8;
    outline-offset: 2px;
  }

  .hero-dot {
    position: relative;
    height: 0.5rem;
    width: 0.5rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.45);
    transition: all 0.25s ease-out;
    cursor: pointer;
  }

  .hero-dot::before {
    content: '';
    position: absolute;
    inset: -0.625rem;
  }

  .hero-dot:hover {
    background: rgb(255 255 255 / 0.85);
  }

  .hero-dot.is-active {
    width: 1.75rem;
    background: #38bdf8;
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.6);
  }
</style>

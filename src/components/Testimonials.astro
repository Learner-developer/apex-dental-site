---
import { googleReviewsUrl } from '../data/site';
import {
  avatarColor,
  avatarInitial,
  formatReviewDate,
  testimonials,
} from '../data/testimonials';

const reviewCount = 482;
---

<section id="reviews" class="gr-section py-16 md:py-20">
  <div class="section-shell">
    <h2 class="sr-only">Google reviews from Apex Dental patients</h2>

    <div
      class="gr-widget"
      x-data={`{
        timer: null,
        go(dir) {
          const track = this.$refs.track;
          const card = track?.querySelector('.gr-card');
          if (!track || !card) return;
          const styles = getComputedStyle(track);
          const gap = parseFloat(styles.columnGap || styles.gap) || 16;
          const step = card.getBoundingClientRect().width + gap;
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const maxScroll = track.scrollWidth - track.clientWidth;
          if (dir === 1 && track.scrollLeft >= maxScroll - 10) {
            track.scrollTo({ left: 0, behavior: reduce ? 'auto' : 'smooth' });
          } else if (dir === -1 && track.scrollLeft <= 10) {
            track.scrollTo({ left: maxScroll, behavior: reduce ? 'auto' : 'smooth' });
          } else {
            track.scrollBy({ left: dir * step, behavior: reduce ? 'auto' : 'smooth' });
          }
        },
        startTimer() {
          clearInterval(this.timer);
          this.timer = setInterval(() => {
            this.go(1);
          }, 4000);
        }
      }`}
      x-init="startTimer()"
      @mouseenter="clearInterval(timer)"
      @mouseleave="startTimer()"
      @focusin="clearInterval(timer)"
      @focusout="startTimer()"
      @touchstart.passive="clearInterval(timer)"
      @touchend.passive="startTimer()"
    >
      <div class="gr-summary">
        <span class="gr-rating-badge">
          <span class="gr-star-icon" aria-hidden="true">★</span> 4.97 Rating
        </span>
        <p class="gr-excellent">EXCELLENT</p>
        <div class="gr-summary-stars" aria-label="4.97 out of 5 stars">
          {Array.from({ length: 5 }).map(() => (
            <svg class="gr-star gr-star-lg" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path>
            </svg>
          ))}
        </div>
        <p class="gr-based">
          Based on{' '}
          <a
            href={googleReviewsUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-analytics-event="click_google_reviews"
            data-analytics-location="testimonials_widget"
            data-analytics-label="Read Reviews Summary"
          >
            {reviewCount} reviews
          </a>
        </p>
        <a
          class="gr-wordmark"
          href={googleReviewsUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-analytics-event="click_google_reviews"
          data-analytics-location="testimonials_widget"
          data-analytics-label="Google Wordmark Link"
          aria-label="Read reviews on Google"
        >
          <img src="/google-wordmark.svg" alt="" width="96" height="32" />
        </a>
      </div>

      <div class="gr-carousel">
        <button
          type="button"
          class="gr-nav gr-nav-prev"
          aria-label="Previous reviews"
          @click="go(-1); startTimer()"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path
              fill="currentColor"
              d="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z"></path>
          </svg>
        </button>

        <div
          class="gr-track"
          x-ref="track"
          tabindex="0"
          role="region"
          aria-label="Patient Google reviews"
        >
          {
            testimonials.map((item) => (
              <article
                class="gr-card"
                x-data="{ open: false, overflow: false }"
                x-init="$nextTick(() => { overflow = $refs.body.scrollHeight > $refs.body.clientHeight + 1 })"
              >
                <div class="gr-card-head">
                  {
                    item.avatarUrl ? (
                      <img
                        src={item.avatarUrl}
                        alt={`${item.author} profile`}
                        class="gr-avatar object-cover"
                        width="40"
                        height="40"
                        loading="lazy"
                      />
                    ) : (
                      <span
                        class="gr-avatar"
                        style={`background:${avatarColor(item.author)}`}
                        aria-hidden="true"
                      >
                        {avatarInitial(item.author)}
                      </span>
                    )
                  }
                  <div class="gr-meta">
                    <p class="gr-name">{item.author}</p>
                    <p class="gr-date">{formatReviewDate(item.date)}</p>
                  </div>
                  <a
                    class="gr-g"
                    href={item.googleReviewUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Read ${item.author}'s review on Google`}
                  >
                    <svg viewBox="0 0 48 48" width="18" height="18" aria-hidden="true">
                      <path
                        fill="#FFC107"
                        d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.1 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.1 8 3l5.7-5.7C34.2 6.1 29.4 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.6-.4-3.9z"
                      />
                      <path
                        fill="#FF3D00"
                        d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.1 8 3l5.7-5.7C34.2 6.1 29.4 4 24 4 16.3 4 9.6 8.3 6.3 14.7z"
                      />
                      <path
                        fill="#4CAF50"
                        d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.1 35.1 26.7 36 24 36c-5.1 0-9.7-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"
                      />
                      <path
                        fill="#1976D2"
                        d="M43.6 20.1H42V20H24v8h11.3c-1.1 3.2-3.5 5.8-6.5 7.5l.1.1 6.2 5.2C36.7 41.8 44 36 44 24c0-1.3-.1-2.6-.4-3.9z"
                      />
                    </svg>
                  </a>
                </div>

                <div class="gr-rating-row">
                  <div class="gr-card-stars" aria-label={`${item.rating} out of 5 stars`}>
                    {Array.from({ length: item.rating }).map(() => (
                      <svg class="gr-star gr-star-sm" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                      </svg>
                    ))}
                  </div>
                  <span class="gr-verified" title="Verified Google review">
                    <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
                      <circle cx="8" cy="8" r="8" fill="#4285F4"></circle>
                      <path
                        d="M4.4 8.2 6.7 10.4 11.6 5.6"
                        fill="none"
                        stroke="#fff"
                        stroke-width="1.7"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      ></path>
                    </svg>
                    <span class="sr-only">Verified Google review</span>
                  </span>
                </div>

                <p class="gr-text" x-ref="body" x-bind:class="open ? 'is-open' : ''">
                  {item.quote}
                </p>
                <button
                  type="button"
                  class="gr-more"
                  x-show="overflow"
                  x-cloak
                  @click="open = !open"
                  x-text="open ? 'Read less' : 'Read more'"
                >
                  Read more
                </button>
              </article>
            ))
          }
        </div>

        <button
          type="button"
          class="gr-nav gr-nav-next"
          aria-label="Next reviews"
          @click="go(1); startTimer()"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path
              fill="currentColor"
              d="M10 6 8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .gr-section {
    background: rgba(29, 225, 218, 0.12);
    overflow-x: clip;
  }

  .gr-widget {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 24px;
    font-family: var(--font-sans);
  }

  .gr-summary {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 8px 12px;
  }

  .gr-rating-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: #151513;
    color: #ffffff;
    font-size: 0.8125rem;
    font-weight: 700;
    padding: 3px 12px;
    border-radius: 9999px;
    letter-spacing: 0.04em;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    margin-bottom: 6px;
  }

  .gr-star-icon {
    color: #fbbc04;
    font-size: 0.875rem;
    line-height: 1;
  }

  .gr-excellent {
    margin: 0;
    color: #151513;
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.15;
    font-family: var(--font-display);
  }

  .gr-summary-stars {
    display: flex;
    gap: 3px;
    margin-top: 6px;
  }

  .gr-star {
    display: block;
    fill: #fbbc04;
  }

  .gr-star-lg {
    width: 28px;
    height: 28px;
  }

  .gr-star-sm {
    width: 16px;
    height: 16px;
  }

  .gr-based {
    margin: 10px 0 0;
    color: #5c5c57;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .gr-based a {
    color: #151513;
    font-weight: 700;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .gr-based a:hover {
    color: #0b7484;
    text-decoration: underline;
  }

  .gr-based a:focus-visible {
    outline: 2px solid #4285f4;
    outline-offset: 3px;
  }

  .gr-wordmark {
    display: inline-flex;
    margin-top: 12px;
    border-radius: 4px;
    transition: transform 0.2s ease-out;
  }

  .gr-wordmark:hover {
    transform: scale(1.05);
  }

  .gr-wordmark:focus-visible {
    outline: 2px solid #4285f4;
    outline-offset: 3px;
  }

  .gr-carousel {
    position: relative;
    min-width: 0;
    display: flex;
    align-items: stretch;
  }

  .gr-track {
    display: flex;
    gap: 16px;
    width: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 8px 4px 12px;
    overscroll-behavior-x: contain;
    touch-action: pan-x;
  }

  .gr-track::-webkit-scrollbar {
    display: none;
  }

  .gr-card {
    display: flex;
    flex-direction: column;
    flex: 0 0 86%;
    scroll-snap-align: start;
    min-height: 210px;
    padding: 16px;
    background: #ffffff;
    border: 1px solid rgba(21, 21, 19, 0.08);
    border-radius: 16px;
    box-shadow: 0 4px 14px rgba(21, 21, 19, 0.04);
    transition: transform 0.25s ease-out, box-shadow 0.25s ease-out, border-color 0.25s ease-out;
  }

  .gr-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(21, 21, 19, 0.09);
    border-color: rgba(29, 225, 218, 0.5);
  }

  .gr-card-head {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) 20px;
    gap: 12px;
    align-items: center;
  }

  .gr-avatar {
    display: inline-flex;
    height: 40px;
    width: 40px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: #fff;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
    transition: transform 0.2s ease-out;
  }

  .gr-card:hover .gr-avatar {
    transform: scale(1.08);
  }

  .gr-meta {
    min-width: 0;
  }

  .gr-name {
    margin: 0;
    overflow: hidden;
    color: #151513;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .gr-date {
    margin: 2px 0 0;
    color: #5c5c57;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .gr-g {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 4px;
    align-self: start;
    transition: transform 0.2s ease;
  }

  .gr-g:hover {
    background: rgb(0 0 0 / 0.04);
    transform: scale(1.1);
  }

  .gr-g:focus-visible {
    outline: 2px solid #4285f4;
    outline-offset: 2px;
  }

  .gr-rating-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
  }

  .gr-card-stars {
    display: flex;
    gap: 1px;
  }

  .gr-verified {
    display: inline-flex;
  }

  .gr-text {
    margin: 8px 0 0;
    color: #2a2a27;
    font-size: 0.875rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    overflow: hidden;
    text-wrap: pretty;
  }

  .gr-text.is-open {
    display: block;
    -webkit-line-clamp: unset;
    overflow: visible;
  }

  .gr-more {
    align-self: start;
    margin-top: 6px;
    padding: 4px 0;
    min-height: 24px;
    border: 0;
    background: none;
    color: #0b7484;
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .gr-more:hover {
    color: #084c56;
    text-decoration: underline;
  }

  .gr-more:focus-visible {
    outline: 2px solid #4285f4;
    outline-offset: 2px;
    border-radius: 2px;
  }

  .gr-wordmark img {
    display: block;
    width: 96px;
    height: auto;
  }

  .gr-nav {
    display: none;
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 44px;
    height: 44px;
    margin-top: -22px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(21, 21, 19, 0.1);
    border-radius: 50%;
    background: #fff;
    color: #151513;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    cursor: pointer;
    transition: all 0.2s ease-out;
  }

  @media (min-width: 768px) {
    .gr-nav {
      display: inline-flex;
    }
  }

  .gr-nav:hover {
    color: #0b7484;
    border-color: #38bdf8;
    background: #ffffff;
    transform: scale(1.08);
    box-shadow: 0 4px 14px rgba(56, 189, 248, 0.4);
  }

  .gr-nav:active {
    transform: scale(0.95);
  }

  .gr-nav:focus-visible {
    outline: 2px solid #4285f4;
    outline-offset: 2px;
  }

  .gr-nav-prev {
    left: -12px;
  }

  .gr-nav-next {
    right: -12px;
  }

  @media (min-width: 640px) {
    .gr-card {
      flex-basis: 70%;
      padding: 20px;
    }
  }

  @media (min-width: 1024px) {
    .gr-widget {
      flex-direction: row;
      align-items: center;
      gap: 16px;
    }

    .gr-summary {
      width: 180px;
      flex-shrink: 0;
      padding: 0 8px;
    }

    .gr-carousel {
      flex: 1;
      min-width: 0;
    }

    .gr-card {
      flex-basis: calc((100% - 32px) / 3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gr-track {
      scroll-behavior: auto;
    }
  }
</style>

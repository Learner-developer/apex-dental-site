---
import { Image } from 'astro:assets';
import { doctorsData, credentialsSummary } from '../data/doctors';
import { getVisualImage } from '../utils/images';

const drJyothi = doctorsData[0];
const drMonika = doctorsData[1];

const consultationImg = getVisualImage('dr-jyothi-sajjan-patient-consultation-desk.webp', 'doctor');
const certificatesImg = getVisualImage('dr-jyothi-sajjan-bds-mds-certificates-registration.jpg', 'doctor');
---

<section id="doctors" class="relative overflow-hidden bg-white py-16 sm:py-24 lg:py-32">
  <!-- Subtle ambient background lighting -->
  <div
    class="blob-shape blob-float pointer-events-none absolute -left-28 top-20 hidden h-96 w-96 bg-[#38bdf8]/10 blur-3xl lg:block"
    aria-hidden="true"
  ></div>
  <div
    class="blob-shape-alt blob-float-slow pointer-events-none absolute -right-24 bottom-24 hidden h-96 w-96 bg-[#c084fc]/10 blur-3xl lg:block"
    aria-hidden="true"
  ></div>

  <div class="section-shell relative">
    <!-- Section Header -->
    <div class="reveal-on-scroll mx-auto max-w-3xl text-center">
      <p class="eyebrow text-[#0284c7]">Clinical Leadership</p>
      <h2 class="section-title">Meet the Specialists</h2>
      <p class="section-lead mx-auto">
        Specialist-led orthodontic and dental care. Every treatment plan is guided by formal postgraduate qualifications and direct doctor commitment.
      </p>
    </div>

    <!-- 1. DR. JYOTHI SAJJAN: Consultation Photo on Left (Sharp Corners, No Tag), Profile on Right -->
    <div class="mt-12 sm:mt-16 grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
      <!-- Left: Consultation Image (Sharp Corners / No Border Radius, No Tag) -->
      <div class="reveal-on-scroll lg:col-span-6">
        <div class="relative aspect-[16/10] sm:aspect-[16/9] lg:aspect-[16/10] w-full overflow-hidden bg-brand/10 shadow-[0_12px_36px_rgba(21,21,19,0.06)]">
          <Image
            src={consultationImg}
            alt={drJyothi.imageAlt || 'Dr. Jyothi Sajjan in patient consultation at desk'}
            class="h-full w-full object-cover object-[18%_center]"
            widths={[400, 600, 900]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Right: Dr. Jyothi Sajjan Details (With Role Tag & Icon-Only LinkedIn) -->
      <div class="reveal-on-scroll reveal-delay-1 lg:col-span-6">
        <div>
          <!-- Role Tag on Right Side -->
          <div class="flex items-center gap-2">
            <span class="eyebrow text-[#0284c7] mb-0">{drJyothi.badge}</span>
            <span class="text-ink/30">•</span>
            <span class="text-xs font-semibold text-brand-deep tracking-wider uppercase">{drJyothi.specialtyTag}</span>
          </div>

          <h3 class="mt-2 font-display text-3xl sm:text-4xl font-extrabold text-ink tracking-tight">
            {drJyothi.name}
          </h3>
          <p class="mt-1 text-sm sm:text-base font-semibold text-ink/75">
            {drJyothi.degrees}
          </p>

          <!-- Badges & Icon-Only Social Links Row -->
          <div class="mt-3.5 flex flex-wrap items-center gap-2.5">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-[#38bdf8]/15 px-3 py-1 text-xs font-semibold text-[#0369a1]">
              <svg class="h-3.5 w-3.5 text-[#0284c7]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              {drJyothi.registration}
            </span>

            <!-- LinkedIn Icon Only -->
            <a
              href={drJyothi.linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-analytics-event="click_doctor_linkedin"
              data-analytics-location="doctors_section"
              data-analytics-label="Dr Jyothi Sajjan LinkedIn"
              class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-ink/15 bg-white text-[#0077b5] transition-all duration-200 hover:border-[#0077b5] hover:bg-[#0077b5] hover:text-white cursor-pointer active:scale-95"
              aria-label="Dr. Jyothi Sajjan LinkedIn Profile"
              title="LinkedIn Profile"
            >
              <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
              </svg>
            </a>
          </div>

          <p class="mt-4 text-base sm:text-lg leading-[1.68] text-ink/80 text-pretty">
            {drJyothi.bio}
          </p>

          <!-- Highlights List -->
          <ul class="mt-6 space-y-2.5">
            {
              drJyothi.highlights.map((highlight) => (
                <li class="flex items-start gap-2.5 text-sm sm:text-base text-ink/85 font-medium">
                  <svg
                    class="h-5 w-5 shrink-0 text-[#0284c7] mt-0.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  <span>{highlight}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- Architectural Hairline Divider -->
    <div class="my-16 md:my-20 h-px w-full bg-gradient-to-r from-transparent via-ink/15 to-transparent" aria-hidden="true"></div>

    <!-- 2. DR. MONIKA MOHANTY: Avatar/Placeholder on Left, Profile on Right -->
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
      <!-- Left: Minimalist Avatar (Floating Directly on Canvas, No Gradient Holder) -->
      <div class="reveal-on-scroll lg:col-span-6 flex items-center justify-center py-6 sm:py-10">
        <div class="relative flex flex-col items-center justify-center text-center">
          <div class="relative flex h-28 w-28 sm:h-32 sm:w-32 items-center justify-center rounded-full bg-ink/5 border border-ink/10 text-ink/40">
            <svg class="h-16 w-16 text-ink/35" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span class="absolute bottom-0 right-0 flex h-8 w-8 items-center justify-center rounded-full bg-white text-xs font-bold text-ink/75 shadow-xs border border-ink/10">
              {drMonika.avatarInitials || 'DM'}
            </span>
          </div>
          <p class="mt-3 text-xs font-semibold uppercase tracking-[0.1em] text-ink/50">
            {drMonika.name}
          </p>
        </div>
      </div>

      <!-- Right: Dr. Monika Mohanty Details -->
      <div class="reveal-on-scroll reveal-delay-1 lg:col-span-6">
        <div>
          <!-- Role Tag on Right Side -->
          <div class="flex items-center gap-2">
            <span class="eyebrow text-[#7e22ce] mb-0">{drMonika.badge}</span>
            <span class="text-ink/30">•</span>
            <span class="text-xs font-semibold text-[#7e22ce] tracking-wider uppercase">{drMonika.specialtyTag}</span>
          </div>

          <h3 class="mt-2 font-display text-3xl sm:text-4xl font-extrabold text-ink tracking-tight">
            {drMonika.name}
          </h3>
          <p class="mt-1 text-sm sm:text-base font-semibold text-ink/75">
            {drMonika.degrees}
          </p>

          <!-- Badges & Icon-Only Social Links Row -->
          <div class="mt-3.5 flex flex-wrap items-center gap-2.5">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-[#c084fc]/15 px-3 py-1 text-xs font-semibold text-[#7e22ce]">
              <svg class="h-3.5 w-3.5 text-[#7e22ce]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              {drMonika.registration}
            </span>

            <!-- LinkedIn Icon Only -->
            <a
              href={drMonika.linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-analytics-event="click_doctor_linkedin"
              data-analytics-location="doctors_section"
              data-analytics-label="Dr Monika Mohanty LinkedIn"
              class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-ink/15 bg-white text-[#0077b5] transition-all duration-200 hover:border-[#0077b5] hover:bg-[#0077b5] hover:text-white cursor-pointer active:scale-95"
              aria-label="Dr. Monika Mohanty LinkedIn Profile"
              title="LinkedIn Profile"
            >
              <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
              </svg>
            </a>
          </div>

          <p class="mt-4 text-base sm:text-lg leading-[1.68] text-ink/80 text-pretty">
            {drMonika.bio}
          </p>

          <!-- Highlights List -->
          <ul class="mt-6 space-y-2.5">
            {
              drMonika.highlights.map((highlight) => (
                <li class="flex items-start gap-2.5 text-sm sm:text-base text-ink/85 font-medium">
                  <svg
                    class="h-5 w-5 shrink-0 text-[#7e22ce] mt-0.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  <span>{highlight}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- Architectural Hairline Divider -->
    <div class="my-16 md:my-20 h-px w-full bg-gradient-to-r from-transparent via-ink/15 to-transparent" aria-hidden="true"></div>

    <!-- 3. CERTIFICATION: Texts on Left, Certificates Image on Right (Sharp Corners) -->
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
      <!-- Left: Certification Texts & Accreditations Breakdown -->
      <div class="reveal-on-scroll lg:col-span-6">
        <div>
          <div class="flex items-center gap-2">
            <span class="eyebrow text-[#0284c7] mb-0">{credentialsSummary.eyebrow}</span>
            <span class="text-ink/30">•</span>
            <span class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-700">
              <svg class="h-3.5 w-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {credentialsSummary.badge}
            </span>
          </div>

          <h3 class="mt-2 font-display text-2xl sm:text-3xl font-extrabold text-ink tracking-tight">
            {credentialsSummary.title}
          </h3>
          <p class="mt-1 text-sm text-ink/70">
            {credentialsSummary.subtitle}
          </p>

          <!-- Audited Credentials List -->
          <div class="mt-6 space-y-4">
            {
              credentialsSummary.items.map((item) => (
                <div class="flex items-start gap-3.5">
                  <span class="inline-flex items-center justify-center shrink-0 rounded bg-[#38bdf8]/15 px-2 py-0.5 font-display text-xs font-extrabold text-[#0369a1] tabular-nums mt-0.5">
                    {item.degree}
                  </span>
                  <div class="leading-snug">
                    <p class="text-sm sm:text-base font-bold text-ink">{item.title}</p>
                    <p class="text-xs text-brand-deep font-semibold">{item.institution}</p>
                    <p class="mt-1 text-xs text-ink/70 leading-relaxed">{item.detail}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Right: Certificates Image (Sharp Corners / No Border Radius) -->
      <div class="reveal-on-scroll reveal-delay-1 lg:col-span-6">
        <div class="relative overflow-hidden bg-cream/30 border border-ink/10 p-2 sm:p-3 shadow-[0_12px_36px_rgba(21,21,19,0.06)]">
          <Image
            src={certificatesImg}
            alt={credentialsSummary.imageAlt}
            class="w-full h-auto object-cover"
            widths={[400, 600, 800]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            loading="lazy"
          />
          <p class="mt-2 text-xs text-center text-ink/65 font-medium">
            Original BDS, MDS & KSDC State Registration certificates on display at clinic
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

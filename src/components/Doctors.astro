---
import { Image } from 'astro:assets';
import consultationImg from '@visuals/03_doctor_and_team/dr-jyothi-sajjan-patient-consultation-desk.jpg';
import certificatesImg from '@visuals/01_branding_and_credentials/dr-jyothi-sajjan-bds-mds-certificates-registration.jpg';
import nskImg from '@visuals/02_clinic_and_facilities/interior_and_equipment/nsk-endo-mate-dt-rotary-endodontic-motor.jpg';
---

<section id="doctors" class="bg-white py-16 md:py-24">
  <div class="section-shell">
    <div class="reveal-on-scroll max-w-3xl">
      <h2 class="section-title">Meet the Doctors</h2>
      <p class="section-lead">
        Specialist-led care from consultation through treatment and follow-up.
      </p>
    </div>

    <div class="mt-10 grid gap-8 lg:grid-cols-3">
      <article class="reveal-on-scroll card-surface card-hover overflow-hidden lg:col-span-2">
        <div class="grid md:grid-cols-2">
          <Image
            src={consultationImg}
            alt="Dr. Jyothi Sajjan in a patient consultation at her desk"
            class="h-full min-h-[260px] w-full object-cover"
            widths={[400, 600, 800]}
            sizes="(max-width: 768px) 100vw, 33vw"
            loading="lazy"
          />
          <div class="p-6 md:p-8">
            <h3 class="text-2xl font-bold text-stone-900">Dr. Jyothi Sajjan</h3>
            <p class="mt-1 text-sm font-medium text-brand-dark">BDS, MDS Orthodontics & Dentofacial Orthopedics</p>
            <p class="mt-4 leading-relaxed text-stone-600">
              Dr. Jyothi Sajjan holds a BDS and an MDS in Orthodontics & Dentofacial Orthopedics,
              and is registered with the Karnataka State Dental Council. She leads every orthodontic
              case at Apex Dental personally — from the first consultation through to the final
              retainer fitting. Patients most often mention how clearly she explains each step before
              starting treatment.
            </p>
          </div>
        </div>
        <div class="border-t border-stone-100 p-4 md:p-6">
          <Image
            src={certificatesImg}
            alt="Dr. Jyothi Sajjan BDS and MDS certificates and Karnataka State Dental Council registration"
            class="w-full rounded-xl object-cover"
            widths={[640, 960, 1200]}
            sizes="(max-width: 1024px) 100vw, 66vw"
            loading="lazy"
          />
        </div>
      </article>

      <article class="reveal-on-scroll card-surface card-hover overflow-hidden">
        <div class="overflow-hidden">
          <Image
            src={nskImg}
            alt="NSK Endo-Mate DT rotary endodontic motor used for root canal treatment"
            class="aspect-video w-full object-cover"
            widths={[400, 600]}
            sizes="(max-width: 1024px) 100vw, 33vw"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <div class="mb-4 flex items-center gap-3">
            <div
              class="flex h-14 w-14 items-center justify-center rounded-full bg-brand text-lg font-bold text-white"
              aria-hidden="true"
            >
              DM
            </div>
            <div>
              <h3 class="text-xl font-bold text-stone-900">Dr. Monika</h3>
              <p class="text-sm font-medium text-brand-dark">Endodontics</p>
            </div>
          </div>
          <!-- TODO: Confirm Dr. Monika's degree/registration details with the clinic before publishing — not included in the source data. -->
          <p class="leading-relaxed text-stone-600">
            Dr. Monika handles root canal and endodontic care at Apex Dental, using rotary
            endodontic technology and digital imaging to keep root canal treatment quick and as
            comfortable as possible.
          </p>
        </div>
      </article>
    </div>
  </div>
</section>

---
import { Image } from 'astro:assets';
import { navLinks, telUrl, whatsappUrl } from '../data/site';
import { getVisualImage } from '../utils/images';

const logo = getVisualImage('apex-dental-clinic-3d-wall-logo.png', 'logo');

const navHoverStyles = [
  'hover:text-[#fb7185] hover:bg-[#fb7185]/15',
  'hover:text-[#c084fc] hover:bg-[#c084fc]/15',
  'hover:text-[#38bdf8] hover:bg-[#38bdf8]/15',
  'hover:text-[#f59e0b] hover:bg-[#f59e0b]/15',
  'hover:text-[#fb7185] hover:bg-[#fb7185]/15',
];

const mobileNavHoverStyles = [
  'hover:bg-[#fb7185]/20 hover:text-[#fb7185]',
  'hover:bg-[#c084fc]/20 hover:text-[#c084fc]',
  'hover:bg-[#38bdf8]/20 hover:text-[#38bdf8]',
  'hover:bg-[#f59e0b]/20 hover:text-[#f59e0b]',
  'hover:bg-[#fb7185]/20 hover:text-[#fb7185]',
];
---

<header x-data="{ open: false }" x-effect="document.body.style.overflow = open ? 'hidden' : ''" @keydown.escape.window="open = false">
  <div class="header-inner section-shell flex items-center justify-between gap-4 py-3 md:py-4 transition-all duration-300 ease-out">
    <a href="#" class="flex shrink-0 items-center transition-transform duration-300 hover:scale-[1.02]" aria-label="Apex Dental home">
      <Image
        src={logo}
        alt="Apex Dental and Orthodontic Clinic logo"
        class="header-logo h-12 w-auto sm:h-14 md:h-16 object-contain transition-all duration-300 ease-out"
        widths={[180, 260, 360, 480]}
        sizes="(max-width: 768px) 180px, 260px"
      />
    </a>

    <nav class="nav-pill transition-all duration-300 ease-out" aria-label="Primary">
      {
        navLinks.map((link, index) => (
          <a
            href={link.href}
            data-analytics-event="nav_click"
            data-analytics-location="header_desktop"
            data-analytics-label={link.label}
            class:list={[
              'nav-pill-item rounded-full px-4 py-2 text-sm font-semibold tracking-[0.01em] text-ink/80 transition-all duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand',
              navHoverStyles[index % navHoverStyles.length],
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions hidden lg:flex items-center gap-2.5 transition-all duration-300 ease-out">
      <a
        href={telUrl}
        data-analytics-event="click_phone"
        data-analytics-location="header_desktop"
        data-analytics-label="Call Now Header"
        class="btn-call header-btn"
      >
        <svg class="btn-icon h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>Call Now</span>
      </a>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-analytics-event="click_whatsapp"
        data-analytics-location="header_desktop"
        data-analytics-label="Book Now Header"
        class="btn-cta header-btn"
      >
        <svg class="btn-icon h-4 w-4 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
        </svg>
        <span>Book Now</span>
      </a>
    </div>

    <button
      type="button"
      class="header-menu-btn inline-flex h-11 w-11 items-center justify-center rounded-full border border-ink/20 text-ink transition-all duration-300 hover:border-[#38bdf8] hover:bg-[#38bdf8]/10 active:scale-95 lg:hidden cursor-pointer"
      @click="open = true"
      :aria-expanded="open"
      aria-controls="mobile-nav"
      aria-label="Open navigation menu"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <div
    id="mobile-nav"
    class="fixed inset-0 z-[70] bg-cream px-6 py-8 lg:hidden flex flex-col justify-between"
    x-show="open"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0 -translate-y-4"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-4"
    x-cloak
    role="dialog"
    aria-modal="true"
    aria-label="Navigation"
  >
    <div>
      <div class="flex items-center justify-between">
        <Image
          src={logo}
          alt="Apex Dental and Orthodontic Clinic logo"
          class="h-11 w-auto object-contain"
          widths={[160, 240]}
          sizes="160px"
        />
        <button
          type="button"
          class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-ink/15 text-ink transition duration-200 hover:bg-ink/5 active:scale-95 cursor-pointer"
          @click="open = false"
          aria-label="Close navigation menu"
        >
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <nav class="mt-10 flex flex-col gap-2" aria-label="Mobile">
        {
          navLinks.map((link, index) => (
            <a
              href={link.href}
              data-analytics-event="nav_click"
              data-analytics-location="mobile_nav"
              data-analytics-label={link.label}
              class:list={[
                'rounded-full px-5 py-3 text-lg font-bold tracking-tight text-ink transition duration-200 active:scale-98',
                mobileNavHoverStyles[index % mobileNavHoverStyles.length],
              ]}
              @click="open = false"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
    <div class="pt-6 border-t border-ink/10 flex flex-col gap-3">
      <a
        href={telUrl}
        data-analytics-event="click_phone"
        data-analytics-location="header_mobile"
        data-analytics-label="Call Now Mobile Nav"
        class="btn-call w-full text-center flex items-center justify-center gap-2"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        Call Now
      </a>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-analytics-event="click_whatsapp"
        data-analytics-location="header_mobile"
        data-analytics-label="Book WhatsApp Mobile Nav"
        class="btn-cta w-full text-center flex items-center justify-center gap-2"
      >
        <svg class="h-4 w-4 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
        </svg>
        <span>Book on WhatsApp</span>
      </a>
    </div>
  </div>
</header>

---
import { Image } from 'astro:assets';
import logo from '@visuals/01_branding_and_credentials/apex-dental-clinic-3d-wall-logo.jpg';
import { navLinks, whatsappUrl } from '../data/site';
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-stone-200/80 bg-cream/95 backdrop-blur-md transition-all duration-200"
  x-data="{ open: false, condensed: false }"
  x-init="window.addEventListener('scroll', () => { condensed = window.scrollY > 100 })"
  :class="condensed ? 'shadow-sm' : ''"
>
  <div class="section-shell flex items-center justify-between gap-4 py-3 md:py-4">
    <a href="#" class="flex shrink-0 items-center gap-3" aria-label="Apex Dental home">
      <Image
        src={logo}
        alt="Apex Dental and Orthodontic Clinic logo"
        class="header-logo h-12 w-auto transition-all duration-200 md:h-14"
        widths={[120, 180, 240]}
        sizes="(max-width: 768px) 120px, 180px"
      />
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-stone-700 transition hover:text-brand-dark"
          >
            {link.label}
          </a>
        ))
      }
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-cta btn-cta-primary">
        Book Now
      </a>
    </nav>

    <button
      type="button"
      class="inline-flex items-center justify-center rounded-lg border border-stone-300 p-2 text-stone-700 lg:hidden"
      @click="open = !open"
      :aria-expanded="open.toString()"
      aria-controls="mobile-nav"
      aria-label="Toggle navigation menu"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <div
    id="mobile-nav"
    class="border-t border-stone-200 bg-white px-4 py-4 lg:hidden"
    x-show="open"
    x-transition
    x-cloak
  >
    <nav class="flex flex-col gap-3" aria-label="Mobile">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-lg px-3 py-2 text-sm font-medium text-stone-700 hover:bg-stone-50"
            @click="open = false"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-cta mt-2 w-full"
      >
        Book Now
      </a>
    </nav>
  </div>
</header>

<style>
  [x-cloak] {
    display: none !important;
  }

  #site-header:not(.is-condensed) .header-logo {
    height: 3rem;
  }

  @media (min-width: 768px) {
    #site-header:not(.is-condensed) .header-logo {
      height: 4rem;
    }

    #site-header.is-condensed .header-logo {
      height: 3rem;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  if (header) {
    const onScroll = () => {
      header.classList.toggle('is-condensed', window.scrollY > 100);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

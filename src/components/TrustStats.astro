---
import { trustStats } from '../data/content';

const statColors = [
  'text-[#fb7185]',
  'text-[#c084fc]',
  'text-[#38bdf8]',
  'text-[#f59e0b]',
];
---

<section
  id="trust-stats-section"
  class="relative overflow-hidden bg-cream/70 py-10 sm:py-12 lg:py-14 border-y border-ink/8"
  aria-label="Clinic key facts"
>
  <div class="section-shell">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-y-8 gap-x-3 sm:gap-x-4 lg:gap-x-0 lg:divide-x lg:divide-ink/10">
      {
        trustStats.map((stat, index) => {
          const hasStar = stat.value.includes('★');
          const cleanValue = stat.value.replace('★', '');

          return (
            <div class="reveal-on-scroll flex flex-col items-center justify-center text-center px-1.5 sm:px-6 lg:px-8 transition-transform duration-200 ease-out hover:-translate-y-0.5 cursor-default">
              <div
                class:list={[
                  'flex items-baseline justify-center font-display text-2xl min-[375px]:text-3xl sm:text-4xl lg:text-[2.75rem] font-extrabold tracking-tight leading-none tabular-nums',
                  statColors[index % statColors.length],
                ]}
              >
                <span class="stat-counter" data-stat-value={cleanValue}>
                  {cleanValue}
                </span>
                {hasStar && (
                  <span class="text-[#f59e0b] text-[0.8em] ml-0.5 select-none" aria-hidden="true">★</span>
                )}
              </div>

              <p class="mt-2.5 text-sm sm:text-base font-bold text-ink leading-snug tracking-[-0.01em]">
                {stat.label}
              </p>

              <p class="mt-1 text-xs sm:text-[0.8125rem] text-ink/65 leading-relaxed max-w-[200px]">
                {stat.sublabel}
              </p>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  function parseStat(str: string) {
    const rangeMatch = str.match(/^(\d+)\s*[-–]\s*(\d+)(.*)$/);
    if (rangeMatch) {
      return {
        type: 'range' as const,
        start: parseInt(rangeMatch[1], 10),
        end: parseInt(rangeMatch[2], 10),
        suffix: rangeMatch[3],
      };
    }
    const decimalMatch = str.match(/^(\d+\.\d+)(.*)$/);
    if (decimalMatch) {
      const num = parseFloat(decimalMatch[1]);
      const decimals = decimalMatch[1].split('.')[1].length;
      return {
        type: 'decimal' as const,
        target: num,
        decimals,
        suffix: decimalMatch[2],
      };
    }
    const intMatch = str.match(/^(\d+)(.*)$/);
    if (intMatch) {
      return {
        type: 'integer' as const,
        target: parseInt(intMatch[1], 10),
        suffix: intMatch[2],
      };
    }
    return null;
  }

  function initStatCounters() {
    const section = document.getElementById('trust-stats-section');
    if (!section) return;

    const counters = section.querySelectorAll<HTMLElement>('.stat-counter');
    if (!counters.length) return;

    let hasAnimated = false;

    const animateCounters = () => {
      if (hasAnimated) return;
      hasAnimated = true;

      const duration = 1800;
      const startTime = performance.now();

      const parsedItems = Array.from(counters).map((el) => {
        const raw = el.dataset.statValue || el.textContent || '';
        return { el, parsed: parseStat(raw), raw };
      });

      function step(currentTime: number) {
        const elapsed = currentTime - startTime;
        const rawProgress = Math.min(elapsed / duration, 1);
        const progress = 1 - Math.pow(1 - rawProgress, 3);

        parsedItems.forEach(({ el, parsed }) => {
          if (!parsed) return;
          if (parsed.type === 'decimal') {
            const val = (progress * parsed.target).toFixed(parsed.decimals);
            el.textContent = `${val}${parsed.suffix}`;
          } else if (parsed.type === 'range') {
            const startVal = Math.round(progress * parsed.start);
            const endVal = Math.round(progress * parsed.end);
            el.textContent = `${startVal}–${endVal}${parsed.suffix}`;
          } else if (parsed.type === 'integer') {
            const val = Math.round(progress * parsed.target);
            el.textContent = `${val}${parsed.suffix}`;
          }
        });

        if (rawProgress < 1) {
          requestAnimationFrame(step);
        } else {
          parsedItems.forEach(({ el, raw }) => {
            el.textContent = raw;
          });
        }
      }

      requestAnimationFrame(step);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateCounters();
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.25,
        rootMargin: '0px 0px -40px 0px',
      }
    );

    observer.observe(section);
  }

  initStatCounters();
  document.addEventListener('astro:page-load', initStatCounters);
</script>

  'M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z',
  'M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5',
];

const badgeColors = [
  'bg-[#fb7185]',
  'bg-[#c084fc]',
  'bg-[#38bdf8]',
  'bg-[#f59e0b]',
  'bg-[#fb7185]',
  'bg-[#c084fc]',
];
---

<section class="relative overflow-hidden bg-cream py-16 sm:py-24 md:py-28">
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="blob-shape blob-float absolute right-10 top-10 hidden h-64 w-64 bg-[#38bdf8]/15 blur-2xl lg:block"></div>
    <div class="blob-shape-alt blob-float-slow absolute left-12 bottom-10 hidden h-56 w-56 bg-[#c084fc]/15 blur-2xl lg:block"></div>
  </div>

  <div class="section-shell relative">
    <div class="reveal-on-scroll mx-auto max-w-2xl text-center lg:mx-0 lg:text-left">
      <p class="eyebrow text-[#fb7185]">Why patients stay</p>
      <h2 class="section-title">Why Choose Apex Dental</h2>
      <p class="section-lead mx-auto lg:mx-0">
        What patients mention most — specialist-led care, faster braces timelines, and follow-up
        that actually happens.
      </p>
    </div>

    <div class="mt-10 sm:mt-12 grid gap-5 sm:gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:pb-10">
      {
        whyChooseItems.map((item, index) => (
          <article
            class:list={[
              'group reveal-on-scroll card-surface card-hover p-6 sm:p-8 border border-ink/5 flex flex-col justify-between',
              index % 2 === 1 && 'lg:translate-y-8',
              index === 2 && 'lg:-translate-y-4',
              index === 0 && 'reveal-delay-1',
              index === 1 && 'reveal-delay-2',
            ]}
          >
            <div>
              <div class="flex items-start justify-between gap-4">
                <div class:list={['icon-badge shadow-sm group-hover:scale-110 group-hover:rotate-6 transition-transform duration-300', badgeColors[index]]}>
                  <svg class="h-6 w-6 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={icons[index]} />
                  </svg>
                </div>
                <span class="font-display tabular-nums text-2xl font-bold text-ink/25 transition-colors duration-300 group-hover:text-brand-deep/60">0{index + 1}</span>
              </div>
              <h3 class="card-title text-xl font-bold text-ink transition-colors duration-200 group-hover:text-brand-deep mt-6">{item.title}</h3>
              <p class="mt-3 text-sm sm:text-base text-ink/80 leading-[1.62] text-pretty">{item.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

---
import { whyChooseItems } from '../data/content';

const icons = [
  'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  'M13 10V3L4 14h7v7l9-11h-7z',
  'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
  'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  'M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z',
  'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
];
---

<section class="py-16 md:py-24">
  <div class="section-shell">
    <div class="reveal-on-scroll max-w-3xl">
      <h2 class="section-title">Why Choose Apex Dental</h2>
      <p class="section-lead">
        What patients mention most — specialist-led care, faster braces timelines, and follow-up
        that actually happens.
      </p>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        whyChooseItems.map((item, index) => (
          <article class="reveal-on-scroll card-surface card-hover p-6">
            <div class="mb-4 inline-flex rounded-xl bg-brand/10 p-3 text-brand-dark">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icons[index]} />
              </svg>
            </div>
            <h3 class="font-bold text-stone-900">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-stone-600">{item.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

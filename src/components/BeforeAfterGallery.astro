---
import { Image } from 'astro:assets';
import { SHOW_BEFORE_AFTER_GALLERY } from '../data/site';
import { beforeAfterFilters, beforeAfterItems } from '../data/gallery';
import { altFromFilename } from '../utils/altText';
import { getVisualImage } from '../utils/images';

const imageMap = beforeAfterItems.map((item) =>
  getVisualImage(item.path || item.filename, 'procedure')
);

const galleryData = beforeAfterItems.map((item, index) => ({
  ...item,
  index,
  alt: altFromFilename(item.filename),
}));
---

{
  SHOW_BEFORE_AFTER_GALLERY && (
    <section id="before-after" class="relative overflow-hidden bg-white py-16 sm:py-24 md:py-28 border-t border-ink/5">
      <div
        class="section-shell"
        x-data={`{
          isOpen: false,
          filter: 'all',
          lightbox: null,
          total: ${galleryData.length},
          openLightbox(index) {
            this.lightbox = index;
            document.body.style.overflow = 'hidden';
          },
          closeLightbox() {
            this.lightbox = null;
            document.body.style.overflow = '';
          },
          next() {
            if (this.lightbox !== null) {
              this.lightbox = (this.lightbox + 1) % this.total;
            }
          },
          prev() {
            if (this.lightbox !== null) {
              this.lightbox = (this.lightbox - 1 + this.total) % this.total;
            }
          }
        }`}
        @keydown.escape.window="closeLightbox()"
        @keydown.arrow-right.window="if (lightbox !== null) next()"
        @keydown.arrow-left.window="if (lightbox !== null) prev()"
      >
        <!-- Section Header -->
        <div class="reveal-on-scroll max-w-2xl">
          <p class="eyebrow text-[#0284c7]">Clinical Transformations</p>
          <h2 class="section-title">Before & After Results</h2>
          <p class="section-lead">
            Documented clinical outcomes treated at Apex Dental — orthodontic crowding corrections, diastema gap closures, dental veneers, and smile rehabilitations.
          </p>
        </div>

        <!-- 1. Category Filter Chips (Always Shown) -->
        <div class="mt-8 flex flex-wrap items-center justify-between gap-3" role="tablist" aria-label="Before and After Filters">
          <div class="flex flex-wrap gap-2 sm:gap-2.5">
            {beforeAfterFilters.map((chip) => (
              <button
                type="button"
                class="rounded-full px-4 py-2 text-xs sm:text-sm font-semibold tracking-wide transition-all duration-200 cursor-pointer active:scale-95 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
                :class={`filter === '${chip.id}' ? 'bg-ink text-white shadow-sm border border-ink' : 'bg-cream border border-ink/10 text-ink hover:bg-[#38bdf8]/15 hover:border-[#38bdf8]/60'`}
                @click={`filter = '${chip.id}'`}
                role="tab"
                :aria-selected={`filter === '${chip.id}'`}
              >
                {chip.label}
              </button>
            ))}
          </div>

          <!-- Quick Hide Button (Shown when gallery is open) -->
          <button
            type="button"
            class="inline-flex items-center gap-1.5 rounded-full border border-ink/15 bg-white px-4 py-2 text-xs font-semibold text-ink/80 transition duration-200 hover:bg-ink hover:text-white cursor-pointer active:scale-95"
            x-show="isOpen"
            x-cloak
            @click="isOpen = false"
          >
            <span>✕ Hide Gallery</span>
          </button>
        </div>

        <!-- 2. Visuals Grid with Individual Image Blur in Wrapped Mode & Floating Unlock Overlay -->
        <div class="relative mt-8 sm:mt-10">
          <!-- Visuals Column Grid -->
          <div class="columns-2 sm:columns-3 lg:columns-4 gap-2.5 sm:gap-3">
            {galleryData.map((item) => (
              <div
                class="break-inside-avoid mb-2.5 sm:mb-3 block"
                x-show={`(isOpen || ${item.index} < 4) && (filter === 'all' || filter === '${item.filter}')`}
                x-transition:enter="transition ease-out duration-300"
                x-transition:enter-start="opacity-0 scale-95"
                x-transition:enter-end="opacity-100 scale-100"
              >
                <button
                  type="button"
                  class="group relative w-full block overflow-hidden rounded-none border-0 bg-ink-soft/5 transition-all duration-300 ease-out text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
                  :class="isOpen ? 'cursor-pointer' : 'cursor-pointer'"
                  @click={`if (isOpen) { openLightbox(${item.index}); } else { isOpen = true; }`}
                  aria-label={`View clinical case: ${item.alt}`}
                >
                  <div class="relative w-full aspect-[4/3] overflow-hidden rounded-none bg-ink/10">
                    <!-- Image with Individual Blur when !isOpen -->
                    <Image
                      src={imageMap[item.index]}
                      alt={item.alt}
                      class="h-full w-full rounded-none object-cover transition-all duration-500 ease-out group-hover:scale-105"
                      :class="!isOpen ? 'blur-[6px] sm:blur-[7px] scale-[1.04] opacity-80' : 'blur-0 scale-100 opacity-100'"
                      widths={[320, 500, 800]}
                      sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw"
                      loading="lazy"
                    />

                    <!-- Full-Width Bottom Hover Overlay (Active only when gallery is open) -->
                    <template x-if="isOpen">
                      <div class="absolute inset-x-0 bottom-0 z-10 w-full transform translate-y-full opacity-0 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100 transition-all duration-300 ease-out">
                        <div class="w-full bg-ink/75 backdrop-blur-md border-t border-white/10 px-3.5 py-3 sm:px-4 sm:py-3.5 text-white">
                          <p class="font-display text-xs sm:text-sm font-bold text-white tracking-tight leading-snug">
                            {item.alt}
                          </p>
                        </div>
                      </div>
                    </template>

                    <!-- Mobile static bottom label when open -->
                    <div
                      class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/85 via-ink/40 to-transparent p-2 sm:hidden text-white"
                      x-show="isOpen"
                    >
                      <p class="text-[11px] font-bold text-white leading-tight line-clamp-1">{item.alt}</p>
                    </div>
                  </div>
                </button>
              </div>
            ))}
          </div>

          <!-- Centered Overlay on Top Layer (Shown strictly when !isOpen - No Fluff) -->
          <div
            class="absolute inset-0 z-20 flex flex-col items-center justify-center bg-ink/40 backdrop-blur-[2px] p-6 text-center transition-all duration-300"
            x-show="!isOpen"
            x-transition:leave="transition ease-in duration-200"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
          >
            <h3 class="font-display text-xl sm:text-2xl md:text-3xl font-extrabold text-white tracking-tight drop-shadow-md">
              Explore 16 Documented Treatment Cases
            </h3>
            <button
              type="button"
              class="mt-4 sm:mt-5 inline-flex min-h-12 items-center justify-center gap-2.5 rounded-full bg-white px-7 py-3.5 text-sm font-bold tracking-wide text-ink shadow-xl transition duration-200 ease-out hover:-translate-y-0.5 hover:bg-white/90 active:scale-95 cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand"
              @click="isOpen = true"
            >
              <span>Click to View Before & After Visuals Gallery</span>
              <svg class="h-4 w-4 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </div>
        </div>

        <!-- 3. Bottom Collapse Bar (Shown when gallery is open) -->
        <div
          class="mt-10 flex flex-col items-center justify-center gap-3 border-t border-ink/10 pt-8 text-center"
          x-show="isOpen"
          x-cloak
        >
          <button
            type="button"
            class="inline-flex items-center gap-2 rounded-full border border-ink/15 bg-white px-6 py-3 text-sm font-semibold tracking-wide text-ink shadow-sm transition duration-200 ease-out hover:-translate-y-0.5 hover:border-ink hover:bg-ink hover:text-white hover:shadow-md active:translate-y-0 active:scale-95 cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand"
            @click="isOpen = false"
          >
            <span>Hide Visuals Gallery</span>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
            </svg>
          </button>
          <p class="text-xs text-ink/60 max-w-md">
            *Disclaimer: Results vary by individual case anatomy and treatment plan. Consult Dr. Jyothi Sajjan for a personalized diagnosis.
          </p>
        </div>

        <!-- 3. Minimal Lightbox Modal Image Viewer (Frosted Blur Background) -->
        <div
          class="fixed inset-0 z-[100] flex flex-col items-center justify-center p-4 sm:p-8 bg-ink/75 backdrop-blur-2xl"
          style="-webkit-backdrop-filter: blur(16px) saturate(180%); backdrop-filter: blur(16px) saturate(180%);"
          x-show="lightbox !== null"
          x-cloak
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
          x-transition:leave="transition ease-in duration-150"
          x-transition:leave-start="opacity-100"
          x-transition:leave-end="opacity-0"
          @click.self="closeLightbox()"
          role="dialog"
          aria-modal="true"
          aria-label="Clinical cases photo viewer"
        >
          <!-- Close Button in Top Right -->
          <button
            type="button"
            class="absolute right-4 top-4 sm:right-6 sm:top-6 z-30 inline-flex h-10 w-10 items-center justify-center rounded-full text-white/75 hover:text-white hover:bg-white/10 transition duration-200 cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand"
            @click="closeLightbox()"
            aria-label="Close image viewer"
          >
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>

          <!-- Left Arrow -->
          <button
            type="button"
            class="absolute left-3 sm:left-6 z-20 inline-flex h-12 w-12 sm:h-14 sm:w-14 items-center justify-center text-white/75 hover:text-white hover:scale-110 active:scale-95 transition duration-200 cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand"
            @click="prev()"
            aria-label="Previous clinical case photo"
          >
            <svg class="h-8 w-8 sm:h-10 sm:w-10 drop-shadow-md" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>

          <!-- Right Arrow -->
          <button
            type="button"
            class="absolute right-3 sm:right-6 z-20 inline-flex h-12 w-12 sm:h-14 sm:w-14 items-center justify-center text-white/75 hover:text-white hover:scale-110 active:scale-95 transition duration-200 cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand"
            @click="next()"
            aria-label="Next clinical case photo"
          >
            <svg class="h-8 w-8 sm:h-10 sm:w-10 drop-shadow-md" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </button>

          <!-- Image & Caption Below Only -->
          <div class="relative flex flex-col items-center justify-center max-w-4xl w-full select-none" @click.stop>
            {galleryData.map((item) => (
              <div
                x-show={`lightbox === ${item.index}`}
                x-cloak
                class="flex flex-col items-center justify-center w-full"
              >
                <!-- Sharp Corner Photo -->
                <Image
                  src={imageMap[item.index]}
                  alt={item.alt}
                  class="max-h-[68vh] sm:max-h-[72vh] w-auto max-w-full rounded-none object-contain shadow-2xl"
                  widths={[800, 1200, 1600]}
                  sizes="(max-width: 1024px) 90vw, 1200px"
                  loading="lazy"
                />

                <div class="mt-4 sm:mt-5 text-center max-w-2xl px-4">
                  <p class="font-display text-base sm:text-lg font-bold text-white tracking-tight text-pretty">
                    {item.alt}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  [x-cloak] {
    display: none !important;
  }
</style>


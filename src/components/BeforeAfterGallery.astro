---
import { Image } from 'astro:assets';
import { SHOW_BEFORE_AFTER_GALLERY } from '../data/site';
import { beforeAfterFilters, beforeAfterItems } from '../data/gallery';
import { altFromFilename } from '../utils/altText';

import type { ImageMetadata } from 'astro';
import img1 from '@visuals/05_before_and_after_cases/orthodontics_braces/before-after-braces-severe-teeth-crowding.jpg';
import img2 from '@visuals/05_before_and_after_cases/orthodontics_braces/before-after-braces-crossbite-canine-alignment.jpg';
import img3 from '@visuals/05_before_and_after_cases/orthodontics_braces/before-after-braces-deep-bite-alignment.png';
import img4 from '@visuals/05_before_and_after_cases/orthodontics_braces/before-after-braces-overbite-profile-correction.png';
import img5 from '@visuals/05_before_and_after_cases/orthodontics_braces/before-after-metal-braces-installation.jpg';
import img6 from '@visuals/05_before_and_after_cases/orthodontics_braces/before-during-after-lower-crowding-metal-braces.jpg';
import img7 from '@visuals/05_before_and_after_cases/cosmetic_and_composite_bonding/before-after-broken-front-tooth-composite-repair.jpg';
import img8 from '@visuals/05_before_and_after_cases/cosmetic_and_composite_bonding/before-after-gap-closure-diastema-composite-bonding-1.jpg';
import img9 from '@visuals/05_before_and_after_cases/cosmetic_and_composite_bonding/before-after-gap-closure-diastema-composite-bonding-2.jpg';
import img10 from '@visuals/05_before_and_after_cases/cosmetic_and_composite_bonding/before-after-gap-closure-diastema-composite-bonding-3.jpg';
import img11 from '@visuals/05_before_and_after_cases/cosmetic_and_composite_bonding/before-after-gap-closure-diastema-labeled.jpg';
import img12 from '@visuals/05_before_and_after_cases/cosmetic_and_composite_bonding/before-after-smile-makeover-dental-veneers.jpg';
import img13 from '@visuals/05_before_and_after_cases/crowns_bridges_dentures/before-after-full-mouth-complete-dentures-senior.jpg';
import img14 from '@visuals/05_before_and_after_cases/crowns_bridges_dentures/before-after-worn-teeth-ceramic-crowns-bridge.jpg';
import img15 from '@visuals/05_before_and_after_cases/crowns_bridges_dentures/before-during-after-anterior-crowns-bridge-rehab.jpg';
import img16 from '@visuals/05_before_and_after_cases/teeth_cleaning_scaling/before-during-after-teeth-scaling-calculus-removal.png';

const imageMap: ImageMetadata[] = [
  img1, img2, img3, img4, img5, img6, img7, img8, img9, img10, img11, img12, img13, img14, img15, img16,
];

const galleryData = beforeAfterItems.map((item, index) => ({
  filter: item.filter,
  alt: altFromFilename(item.filename),
  index,
}));
---

{
  SHOW_BEFORE_AFTER_GALLERY && (
    <section id="before-after" class="bg-white py-16 md:py-24">
      <div class="section-shell">
        <div class="max-w-3xl">
          <h2 class="section-title">Before & After Gallery</h2>
          <p class="section-lead">
            A look at real cases treated at Apex Dental. Every result varies by case — ask about your
            own treatment plan at a free consultation.
          </p>
        </div>

        <div
          class="mt-8"
          x-data="{ filter: 'all', lightbox: null }"
        >
          <div class="flex flex-wrap gap-2">
            {beforeAfterFilters.map((chip) => (
              <button
                type="button"
                class="rounded-full px-4 py-2 text-sm font-semibold transition"
                x-bind:class={`filter === '${chip.id}' ? 'bg-brand text-white' : 'bg-stone-100 text-stone-700 hover:bg-stone-200'`}
                x-on:click={`filter = '${chip.id}'`}
              >
                {chip.label}
              </button>
            ))}
          </div>

          <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {galleryData.map((item) => (
              <button
                type="button"
                class="group overflow-hidden rounded-2xl text-left shadow-[var(--shadow-soft)] transition hover:-translate-y-1 hover:shadow-[var(--shadow-lift)]"
                x-show={`filter === 'all' || filter === '${item.filter}'`}
                x-on:click={`lightbox = ${item.index}`}
              >
                <Image
                  src={imageMap[item.index]}
                  alt={item.alt}
                  class="aspect-[4/3] w-full object-cover transition group-hover:scale-[1.02]"
                  widths={[400, 600, 800]}
                  sizes="(max-width: 768px) 100vw, 33vw"
                  loading="lazy"
                />
              </button>
            ))}
          </div>

          <div
            class="fixed inset-0 z-[60] flex items-center justify-center bg-stone-900/80 p-4"
            x-show="lightbox !== null"
            x-cloak
            x-on:click.self="lightbox = null"
            x-on:keydown.escape.window="lightbox = null"
          >
            <div class="relative max-h-[90vh] max-w-5xl overflow-auto rounded-2xl bg-white p-2">
              <button
                type="button"
                class="absolute right-3 top-3 rounded-full bg-stone-900/70 px-3 py-1 text-sm text-white"
                x-on:click="lightbox = null"
              >
                Close
              </button>
              {galleryData.map((item) => (
                <div x-show={`lightbox === ${item.index}`}>
                  <Image
                    src={imageMap[item.index]}
                    alt={item.alt}
                    class="max-h-[85vh] w-full rounded-xl object-contain"
                    widths={[800, 1200]}
                    sizes="90vw"
                    loading="lazy"
                  />
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  [x-cloak] {
    display: none !important;
  }
</style>

---
import { faqItems } from '../data/content';
---

<section id="faq" class="relative overflow-hidden bg-cream py-20 md:py-28">
  <div
    class="blob-shape blob-float-slow pointer-events-none absolute -right-24 top-20 hidden h-72 w-72 bg-[#1de1da]/15 blur-2xl lg:block"
    aria-hidden="true"
  ></div>
  <div
    class="blob-shape-alt blob-float pointer-events-none absolute -left-20 bottom-10 hidden h-64 w-64 bg-[#53ecc2]/15 blur-2xl lg:block"
    aria-hidden="true"
  ></div>

  <div class="section-shell">
    <div class="lg:grid lg:grid-cols-12 lg:gap-16">
      <div class="reveal-on-scroll lg:col-span-4 lg:sticky lg:top-28 lg:self-start">
        <p class="eyebrow">Got questions?</p>
        <h2 class="section-title">Frequently Asked Questions</h2>
        <p class="section-lead">
          Common questions about braces, root canals, pricing, and sterilization.
        </p>
      </div>

      <div class="mt-12 space-y-3.5 lg:col-span-8 lg:mt-0" x-data="{ open: 0 }">
        {
          faqItems.map((item, index) => (
            <div class="overflow-hidden rounded-2xl bg-white border border-ink/5 shadow-[var(--shadow-soft)] transition-all duration-300 hover:shadow-md">
              <button
                type="button"
                class="group flex w-full items-start gap-4 px-5 py-5 text-left md:px-8 hover:bg-[#1de1da]/10 transition-colors duration-200 cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
                @click={`open = open === ${index} ? -1 : ${index}`}
                :aria-expanded={`open === ${index}`}
              >
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#1de1da]/25 font-display text-sm font-bold text-ink transition-all duration-200 group-hover:bg-[#1de1da] group-hover:scale-105">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="flex-1 pt-1 font-semibold text-ink transition-colors duration-200 group-hover:text-brand-deep">{item.question}</span>
                <span
                  class="mt-1 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-ink/20 text-ink transition-all duration-200 group-hover:border-[#1de1da] group-hover:bg-[#1de1da]/20 group-hover:scale-105"
                  aria-hidden="true"
                  x-text={`open === ${index} ? '−' : '+'`}
                ></span>
              </button>
              <div
                class="px-5 pb-6 text-ink/75 leading-relaxed md:px-8 md:pl-[4.75rem]"
                x-show={`open === ${index}`}
                x-cloak
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0 -translate-y-2"
                x-transition:enter-end="opacity-100 translate-y-0"
              >
                {item.answer}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  [x-cloak] {
    display: none !important;
  }
</style>

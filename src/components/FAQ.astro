---
import { faqItems } from '../data/content';

const faqNumberColors = [
  'bg-[#fb7185]/20 group-hover:bg-[#fb7185] group-hover:text-white',
  'bg-[#c084fc]/20 group-hover:bg-[#c084fc] group-hover:text-white',
  'bg-[#38bdf8]/20 group-hover:bg-[#38bdf8] group-hover:text-white',
  'bg-[#f59e0b]/20 group-hover:bg-[#f59e0b] group-hover:text-white',
];
---

<section id="faq" class="relative overflow-hidden bg-cream py-16 sm:py-24 md:py-28">
  <div
    class="blob-shape blob-float-slow pointer-events-none absolute -right-24 top-20 hidden h-72 w-72 bg-[#38bdf8]/15 blur-2xl lg:block"
    aria-hidden="true"
  ></div>
  <div
    class="blob-shape-alt blob-float pointer-events-none absolute -left-20 bottom-10 hidden h-64 w-64 bg-[#c084fc]/15 blur-2xl lg:block"
    aria-hidden="true"
  ></div>

  <div class="section-shell">
    <div class="lg:grid lg:grid-cols-12 lg:gap-16">
      <div class="reveal-on-scroll lg:col-span-4 lg:sticky lg:top-28 lg:self-start">
        <p class="eyebrow text-[#fb7185]">Got questions?</p>
        <h2 class="section-title">Frequently Asked Questions</h2>
        <p class="section-lead">
          Common questions about braces, root canals, pricing, and sterilization.
        </p>
      </div>

      <div class="mt-10 sm:mt-12 space-y-3.5 lg:col-span-8 lg:mt-0" x-data="{ open: 0 }">
        {
          faqItems.map((item, index) => (
            <div class="overflow-hidden rounded-2xl bg-white border border-ink/5 shadow-[var(--shadow-soft)] transition-all duration-300 hover:shadow-md">
              <button
                type="button"
                data-analytics-event="toggle_faq"
                data-analytics-location="faq_section"
                data-analytics-label={item.question}
                class="group flex w-full items-start text-left gap-3 sm:gap-4 px-4 py-4 sm:px-6 md:px-8 hover:bg-cream/60 transition-colors duration-200 cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
                @click={`open = open === ${index} ? -1 : ${index}`}
                :aria-expanded={`open === ${index}`}
              >
                <span
                  class:list={[
                    'inline-flex h-8 w-8 sm:h-10 sm:w-10 shrink-0 items-center justify-center rounded-full font-display tabular-nums text-xs sm:text-sm font-bold text-ink transition-all duration-200 group-hover:scale-105',
                    faqNumberColors[index % faqNumberColors.length],
                  ]}
                >
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="flex-1 pt-0.5 sm:pt-1 text-left text-sm sm:text-base md:text-lg font-bold text-ink transition-colors duration-200 group-hover:text-brand-deep tracking-[-0.01em]">{item.question}</span>
                <span
                  class="mt-0.5 sm:mt-1 inline-flex h-7 w-7 sm:h-8 sm:w-8 shrink-0 items-center justify-center rounded-full border border-ink/20 text-ink transition-all duration-200 group-hover:border-[#38bdf8] group-hover:bg-[#38bdf8]/20 group-hover:scale-105 text-sm sm:text-base font-semibold"
                  aria-hidden="true"
                  x-text={`open === ${index} ? '−' : '+'`}
                ></span>
              </button>
              <div
                class="text-left px-4 pb-5 text-sm sm:text-base text-ink/80 leading-[1.65] text-pretty sm:px-6 md:px-8 md:pl-[4.75rem]"
                x-show={`open === ${index}`}
                x-cloak
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0 -translate-y-2"
                x-transition:enter-end="opacity-100 translate-y-0"
              >
                {item.answer}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  [x-cloak] {
    display: none !important;
  }
</style>

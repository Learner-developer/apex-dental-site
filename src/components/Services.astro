---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { services } from '../data/services';
import { altFromFilename } from '../utils/altText';

import orthoImg from '@visuals/04_treatment_educational/braces-types-lingual-metal-ceramic-clear.jpg';
import rctImg from '@visuals/02_clinic_and_facilities/interior_and_equipment/nsk-endo-mate-dt-rotary-endodontic-motor.jpg';
import surgeryImg from '@visuals/03_doctor_and_team/dental-examination-instruments-procedure-closeup.jpg';
import prosthImg from '@visuals/02_clinic_and_facilities/interior_and_equipment/dental-chair-unit-side-view.jpg';
import cosmeticImg from '@visuals/03_doctor_and_team/dr-jyothi-sajjan-patient-consultation-desk.jpg';
import perioImg from '@visuals/02_clinic_and_facilities/interior_and_equipment/sterilization-room-autoclave-and-storage.jpg';
import pediatricImg from '@visuals/02_clinic_and_facilities/interior_and_equipment/treatment-operatory-green-chair-setup.jpg';

const serviceImages: Record<string, ImageMetadata> = {
  orthodontics: orthoImg,
  'root-canal': rctImg,
  'oral-surgery': surgeryImg,
  prosthodontics: prosthImg,
  cosmetic: cosmeticImg,
  periodontics: perioImg,
  pediatric: pediatricImg,
};

const bentoClass = [
  'lg:col-span-8 lg:row-span-2',
  'lg:col-span-4',
  'lg:col-span-4',
  'lg:col-span-3',
  'lg:col-span-3',
  'lg:col-span-3',
  'lg:col-span-3',
];

const accentDots = [
  'bg-[#24d3e9]',
  'bg-[#1de1da]',
  'bg-[#53ecc2]',
  'bg-[#8af4a4]',
  'bg-[#c1f886]',
  'bg-[#24d3e9]',
  'bg-[#1de1da]',
];
---

<section id="services" class="relative overflow-hidden bg-cream py-20 md:py-28">
  <div
    class="blob-shape blob-float pointer-events-none absolute -right-24 top-20 h-72 w-72 bg-[#1de1da]/15 blur-2xl"
    aria-hidden="true"
  ></div>
  <div
    class="blob-shape-alt blob-float-slow pointer-events-none absolute -left-16 bottom-10 h-56 w-56 bg-[#53ecc2]/15 blur-2xl"
    aria-hidden="true"
  ></div>

  <div class="section-shell relative">
    <div class="reveal-on-scroll flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <p class="eyebrow">Treatments</p>
        <h2 class="section-title">Core Services</h2>
        <p class="section-lead">
          Seven departments under one roof — from braces and root canals to implants, cosmetic care,
          and family dentistry.
        </p>
      </div>
    </div>

    <div
      class="relative mt-12"
      x-data="{
        active: 0,
        go(dir) {
          const track = this.$refs.track;
          const card = track.querySelector('article');
          const amount = card ? card.getBoundingClientRect().width + 24 : track.clientWidth * 0.7;
          track.scrollBy({ left: dir * amount, behavior: 'smooth' });
        },
        onScroll() {
          const track = this.$refs.track;
          const card = track.querySelector('article');
          if (!card) return;
          this.active = Math.round(track.scrollLeft / (card.getBoundingClientRect().width + 24));
        }
      }"
    >
      <div class="mb-6 flex justify-end gap-2 lg:hidden">
        <button type="button" class="slider-btn" aria-label="Previous services" @click="go(-1)">
          <span aria-hidden="true">←</span>
        </button>
        <button type="button" class="slider-btn" aria-label="Next services" @click="go(1)">
          <span aria-hidden="true">→</span>
        </button>
      </div>

      <div
        x-ref="track"
        class="flex snap-x snap-mandatory gap-6 overflow-x-auto pb-4 [-ms-overflow-style:none] [scrollbar-width:none] lg:grid lg:grid-cols-12 lg:overflow-visible lg:pb-0 lg:snap-none [&::-webkit-scrollbar]:hidden"
        @scroll.passive="onScroll()"
        @keydown.left.prevent="go(-1)"
        @keydown.right.prevent="go(1)"
        tabindex="0"
        role="region"
        aria-label="Core services"
      >
        {
          services.map((service, index) => (
            <article
              class:list={[
                'group w-[85%] shrink-0 snap-start sm:w-[58%] lg:w-full lg:min-w-0 lg:shrink',
                bentoClass[index],
              ]}
            >
              <div class="card-surface card-hover h-full overflow-hidden border border-ink/5 flex flex-col justify-between">
                <div>
                  <div class="overflow-hidden">
                    <Image
                      src={serviceImages[service.id]}
                      alt={altFromFilename(service.imagePath.split('/').pop() ?? service.id)}
                      class:list={[
                        'w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105',
                        index === 0 ? 'aspect-[16/10] lg:aspect-[16/9]' : 'aspect-[16/10]',
                      ]}
                      widths={[480, 640, 800]}
                      sizes={
                        index === 0
                          ? '(max-width: 640px) 85vw, (max-width: 1024px) 58vw, 66vw'
                          : '(max-width: 640px) 85vw, (max-width: 1024px) 58vw, 25vw'
                      }
                      loading="lazy"
                    />
                  </div>
                  <div class:list={['p-6 md:p-8', index === 0 && 'lg:p-10']}>
                    <h3
                      class:list={[
                        'font-display font-semibold text-ink transition-colors duration-200 group-hover:text-brand-deep',
                        index === 0 ? 'text-2xl lg:text-3xl' : 'text-xl lg:text-2xl',
                      ]}
                    >
                      {service.title}
                    </h3>
                    <p class="mt-3 text-base text-ink/70 leading-relaxed">{service.intro}</p>
                    <ul class="mt-5 space-y-3 text-[0.95rem] text-ink/80">
                      {service.items.map((item) => (
                        <li class="flex gap-3 items-start">
                          <span
                            class:list={['mt-2 h-1.5 w-1.5 shrink-0 rounded-full shadow-sm', accentDots[index]]}
                            aria-hidden="true"
                          />
                          <span>
                            <strong class="font-semibold text-ink">{item.name}</strong> — {item.description}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
                {service.footer && (
                  <div class:list={['px-6 pb-6 md:px-8 md:pb-8', index === 0 && 'lg:px-10 lg:pb-10']}>
                    <p class="pt-4 border-t border-ink/5 text-sm font-medium text-brand-deep">{service.footer}</p>
                  </div>
                )}
              </div>
            </article>
          ))
        }
      </div>

      <div class="mt-6 flex justify-center gap-2 lg:hidden" aria-hidden="true">
        {
          services.map((_, index) => (
            <span
              class="h-1.5 w-6 rounded-full transition-all duration-300"
              :class={`active === ${index} ? 'bg-[#1de1da] w-8' : 'bg-ink/15'`}
            />
          ))
        }
      </div>
      <p class="sr-only" aria-live="polite" x-text="`Slide ${active + 1} of 7`"></p>
    </div>
  </div>
</section>

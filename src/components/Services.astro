---
import { Image } from 'astro:assets';
import { services } from '../data/services';
import { whatsappNumber, phoneTel } from '../data/site';
import { altFromFilename } from '../utils/altText';
import { getVisualImage } from '../utils/images';

interface DeptTheme {
  id: string;
  badgeColor: string;
  numBg: string;
  numText: string;
  activeBorder: string;
  activeText: string;
  hoverBg: string;
  hoverText: string;
  accentText: string;
  mobileActive: string;
}

const deptThemes: Record<string, DeptTheme> = {
  orthodontics: {
    id: 'orthodontics',
    badgeColor: 'bg-[#c084fc]/15 text-[#7e22ce] border-[#c084fc]/30',
    numBg: 'bg-[#c084fc]/20 border border-[#c084fc]/40',
    numText: 'text-[#7e22ce]',
    activeBorder: 'border-[#9333ea]',
    activeText: 'text-[#7e22ce]',
    hoverBg: 'hover:bg-[#faf5ff]',
    hoverText: 'group-hover:text-[#7e22ce]',
    accentText: 'text-[#7e22ce]',
    mobileActive: 'bg-[#7e22ce] text-white border-[#7e22ce]',
  },
  'root-canal': {
    id: 'root-canal',
    badgeColor: 'bg-[#f59e0b]/15 text-[#b45309] border-[#f59e0b]/30',
    numBg: 'bg-[#f59e0b]/20 border border-[#f59e0b]/40',
    numText: 'text-[#b45309]',
    activeBorder: 'border-[#f59e0b]',
    activeText: 'text-[#b45309]',
    hoverBg: 'hover:bg-[#fffbeb]',
    hoverText: 'group-hover:text-[#b45309]',
    accentText: 'text-[#b45309]',
    mobileActive: 'bg-[#b45309] text-white border-[#b45309]',
  },
  prosthodontics: {
    id: 'prosthodontics',
    badgeColor: 'bg-[#fb7185]/15 text-[#be123c] border-[#fb7185]/30',
    numBg: 'bg-[#fb7185]/20 border border-[#fb7185]/40',
    numText: 'text-[#be123c]',
    activeBorder: 'border-[#fb7185]',
    activeText: 'text-[#be123c]',
    hoverBg: 'hover:bg-[#fff1f2]',
    hoverText: 'group-hover:text-[#be123c]',
    accentText: 'text-[#be123c]',
    mobileActive: 'bg-[#be123c] text-white border-[#be123c]',
  },
  cosmetic: {
    id: 'cosmetic',
    badgeColor: 'bg-[#38bdf8]/15 text-[#0369a1] border-[#38bdf8]/30',
    numBg: 'bg-[#38bdf8]/20 border border-[#38bdf8]/40',
    numText: 'text-[#0369a1]',
    activeBorder: 'border-[#0284c7]',
    activeText: 'text-[#0369a1]',
    hoverBg: 'hover:bg-[#f0f9ff]',
    hoverText: 'group-hover:text-[#0369a1]',
    accentText: 'text-[#0369a1]',
    mobileActive: 'bg-[#0284c7] text-white border-[#0284c7]',
  },
  'oral-surgery': {
    id: 'oral-surgery',
    badgeColor: 'bg-[#818cf8]/15 text-[#4338ca] border-[#818cf8]/30',
    numBg: 'bg-[#818cf8]/20 border border-[#818cf8]/40',
    numText: 'text-[#4338ca]',
    activeBorder: 'border-[#6366f1]',
    activeText: 'text-[#4338ca]',
    hoverBg: 'hover:bg-[#eef2ff]',
    hoverText: 'group-hover:text-[#4338ca]',
    accentText: 'text-[#4338ca]',
    mobileActive: 'bg-[#4338ca] text-white border-[#4338ca]',
  },
  periodontics: {
    id: 'periodontics',
    badgeColor: 'bg-[#2dd4bf]/15 text-[#0f766e] border-[#2dd4bf]/30',
    numBg: 'bg-[#2dd4bf]/20 border border-[#2dd4bf]/40',
    numText: 'text-[#0f766e]',
    activeBorder: 'border-[#14b8a6]',
    activeText: 'text-[#0f766e]',
    hoverBg: 'hover:bg-[#f0fdfa]',
    hoverText: 'group-hover:text-[#0f766e]',
    accentText: 'text-[#0f766e]',
    mobileActive: 'bg-[#0f766e] text-white border-[#0f766e]',
  },
  pediatric: {
    id: 'pediatric',
    badgeColor: 'bg-[#34d399]/15 text-[#047857] border-[#34d399]/30',
    numBg: 'bg-[#34d399]/20 border border-[#34d399]/40',
    numText: 'text-[#047857]',
    activeBorder: 'border-[#10b981]',
    activeText: 'text-[#047857]',
    hoverBg: 'hover:bg-[#f0fdf4]',
    hoverText: 'group-hover:text-[#047857]',
    accentText: 'text-[#047857]',
    mobileActive: 'bg-[#047857] text-white border-[#047857]',
  },
};
---

<section
  id="services"
  class="relative overflow-hidden bg-cream/70 py-20 md:py-28 lg:py-32 border-t border-ink/5"
  x-data="{
    activeDept: 'orthodontics',
    validDepts: ['orthodontics', 'root-canal', 'prosthodontics', 'cosmetic', 'oral-surgery', 'periodontics', 'pediatric'],
    init() {
      const syncHash = () => {
        const hash = window.location.hash.replace('#dept-', '');
        if (this.validDepts.includes(hash)) {
          this.activeDept = hash;
        }
      };
      syncHash();
      window.addEventListener('hashchange', syncHash);
      window.addEventListener('select-dept', (e) => {
        if (e.detail && this.validDepts.includes(e.detail)) {
          this.activeDept = e.detail;
        }
      });
    }
  }"
>
  <!-- Subtle ambient background lighting -->
  <div
    class="blob-shape blob-float pointer-events-none absolute -right-24 top-20 hidden h-80 w-80 bg-[#38bdf8]/10 blur-3xl lg:block"
    aria-hidden="true"
  ></div>
  <div
    class="blob-shape-alt blob-float-slow pointer-events-none absolute -left-20 bottom-20 hidden h-80 w-80 bg-[#c084fc]/10 blur-3xl lg:block"
    aria-hidden="true"
  ></div>

  <div class="section-shell relative">
    <!-- Header -->
    <div class="reveal-on-scroll max-w-3xl">
      <p class="eyebrow text-[#0284c7]">Treatments & Specialties</p>
      <h2 class="section-title">Core Clinical Departments</h2>
      <p class="section-lead">
        Seven specialized departments under one roof.
      </p>
    </div>

    <!-- Mobile / Small Screens: Horizontal Scrollable Themed Department Selector -->
    <div class="lg:hidden mt-8 -mx-4 px-4 overflow-x-auto pb-2 flex gap-2 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" role="tablist" aria-label="Select Clinical Department">
      {
        services.map((service, idx) => {
          const theme = deptThemes[service.id] || deptThemes.orthodontics;
          return (
            <button
              type="button"
              class="shrink-0 inline-flex items-center gap-2 rounded-full px-4 py-2.5 text-xs font-bold transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand border cursor-pointer active:scale-95 min-h-[40px]"
              :class={`activeDept === '${service.id}' ? '${theme.mobileActive} shadow-xs' : 'bg-white/90 text-ink/75 hover:bg-white hover:text-ink border-ink/10'`}
              @click={`activeDept = '${service.id}'; $el.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' })`}
              role="tab"
              :aria-selected={`activeDept === '${service.id}' ? 'true' : 'false'`}
            >
              <span
                class="inline-flex h-4 w-4 items-center justify-center rounded-full text-[10px] font-extrabold"
                :class={`activeDept === '${service.id}' ? 'bg-white/25 text-white' : '${theme.numBg} ${theme.numText}'`}
              >
                {idx + 1}
              </span>
              <span>{service.shortTitle || service.title}</span>
            </button>
          );
        })
      }
    </div>

    <!-- Main Layout: Left Department Directory + Right Showcase Pane -->
    <div class="mt-8 lg:mt-14 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      <!-- Left Column: Desktop Department Index (Sticky with Themed Colors) -->
      <div class="hidden lg:block lg:col-span-4 sticky top-28 space-y-1.5" role="tablist" aria-label="Clinical Departments Directory">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-ink/50 mb-3 px-3">Select Specialty</p>
        {
          services.map((service, idx) => {
            const theme = deptThemes[service.id] || deptThemes.orthodontics;
            return (
              <button
                type="button"
                class:list={[
                  'w-full text-left rounded-xl p-3.5 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand flex items-center justify-between group cursor-pointer border-l-4',
                  theme.hoverBg,
                ]}
                :class={`activeDept === '${service.id}' ? 'bg-white shadow-sm ${theme.activeBorder}' : 'border-transparent text-ink/70 hover:text-ink'`}
                @click={`activeDept = '${service.id}'`}
                role="tab"
                :aria-selected={`activeDept === '${service.id}' ? 'true' : 'false'`}
              >
                <div class="flex items-center gap-3">
                  <!-- Themed Number Pill -->
                  <span
                    class:list={[
                      'inline-flex h-7 w-7 items-center justify-center rounded-lg text-xs font-extrabold tabular-nums transition-transform duration-200 group-hover:scale-105 shadow-2xs',
                      theme.numBg,
                      theme.numText,
                    ]}
                  >
                    0{idx + 1}
                  </span>
                  <!-- Themed Specialty Title -->
                  <span
                    class:list={[
                      'text-sm font-medium transition-colors duration-200',
                      theme.hoverText,
                    ]}
                    :class={`activeDept === '${service.id}' ? 'font-bold ${theme.activeText}' : ''`}
                  >
                    {service.shortTitle || service.title}
                  </span>
                </div>
                <!-- Themed Arrow Indicator -->
                <svg
                  class:list={[
                    'h-4 w-4 shrink-0 transition-all duration-200',
                    theme.accentText,
                  ]}
                  :class={`activeDept === '${service.id}' ? 'translate-x-0.5 opacity-100' : 'opacity-0 group-hover:opacity-60'`}
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                </svg>
              </button>
            );
          })
        }
      </div>

      <!-- Right Column: Department Detail Showcase Pane (Cardless / Open Editorial) -->
      <div class="lg:col-span-8">
        {
          services.map((service) => {
            const theme = deptThemes[service.id] || deptThemes.orthodontics;
            const waUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(service.whatsappQuery)}`;
            
            return (
              <article
                id={`dept-${service.id}`}
                class="scroll-mt-28"
                x-show={`activeDept === '${service.id}'`}
                x-transition:enter="transition ease-out duration-250"
                x-transition:enter-start="opacity-0 translate-y-2"
                x-transition:enter-end="opacity-100 translate-y-0"
              >
                <!-- Department Header with Themed Badge -->
                <div class="mb-2">
                  <span class:list={['inline-flex items-center gap-1.5 rounded-full px-3 py-0.5 text-xs font-bold border shadow-2xs', theme.badgeColor]}>
                    <span class="h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true"></span>
                    {service.badge}
                  </span>
                </div>

                <h3 class="font-display text-2xl sm:text-3xl lg:text-4xl font-extrabold text-ink tracking-tight">
                  {service.title}
                </h3>

                <p class="mt-3 text-base sm:text-lg text-ink/80 leading-relaxed max-w-2xl text-pretty">
                  {service.intro}
                </p>

                <!-- Media + Procedures Layout -->
                <div class="mt-8 grid grid-cols-1 sm:grid-cols-12 gap-6 sm:gap-8 items-start">
                  <!-- Compact Refined Image (Proportional, Clean Framing) -->
                  <div class="sm:col-span-5">
                    <div class="relative aspect-[4/3] w-full overflow-hidden bg-ink/5 border border-ink/10 shadow-[0_4px_20px_rgba(21,21,19,0.04)]">
                      <Image
                        src={getVisualImage(service.imagePath, 'procedure')}
                        alt={altFromFilename(service.imagePath.split('/').pop() ?? service.id)}
                        class="h-full w-full object-cover"
                        widths={[320, 480, 640]}
                        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 40vw, 320px"
                        loading="lazy"
                      />
                    </div>
                  </div>

                  <!-- Procedures Checklist with Themed Bullet Icons -->
                  <div class="sm:col-span-7">
                    <p class="text-xs font-bold uppercase tracking-[0.14em] text-ink/50 mb-3">Key Procedures</p>
                    <ul class="space-y-3">
                      {service.items.map((item) => (
                        <li class="flex items-start gap-2.5 text-sm text-ink/85 leading-relaxed">
                          <svg class:list={['h-4 w-4 mt-1 shrink-0', theme.accentText]} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                          </svg>
                          <span>
                            <strong class="font-semibold text-ink">{item.name}</strong> — {item.description}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <!-- Minimal WhatsApp CTA Only -->
                <div class="mt-8 flex items-center">
                  <a
                    href={waUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-analytics-event="click_service_whatsapp"
                    data-analytics-location="services_department"
                    data-analytics-label={service.title}
                    data-analytics-dept={service.id}
                    class="inline-flex min-h-[44px] w-full sm:w-auto items-center justify-center gap-2 rounded-full border border-[#25D366] bg-[#25D366] px-6 py-2.5 text-xs sm:text-sm font-semibold tracking-wide text-white shadow-xs transition-all duration-200 ease-out hover:bg-transparent hover:text-[#25D366] active:scale-95"
                    aria-label={`Book appointment for ${service.title} on WhatsApp`}
                  >
                    <svg class="h-4 w-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2ZM12.05 20.15C10.57 20.15 9.12 19.76 7.85 19.01L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.8 7.37 7.5 3.67 12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.05 20.15ZM16.57 14.33C16.32 14.2 15.1 13.6 14.87 13.52C14.64 13.43 14.48 13.39 14.31 13.64C14.15 13.89 13.68 14.45 13.54 14.61C13.4 14.78 13.25 14.8 13 14.68C12.75 14.55 11.94 14.29 10.99 13.44C10.25 12.78 9.74 11.96 9.6 11.71C9.46 11.46 9.58 11.33 9.71 11.2C9.82 11.09 9.96 10.91 10.08 10.77C10.21 10.63 10.25 10.52 10.33 10.36C10.41 10.19 10.37 10.05 10.31 9.93C10.25 9.8 9.75 8.58 9.55 8.08C9.35 7.59 9.14 7.66 8.99 7.65C8.84 7.64 8.68 7.64 8.51 7.64C8.35 7.64 8.08 7.7 7.86 7.94C7.63 8.19 7 8.78 7 9.98C7 11.18 7.88 12.34 8 12.5C8.12 12.67 9.73 15.15 12.2 16.22C12.79 16.47 13.25 16.62 13.6 16.74C14.19 16.92 14.73 16.9 15.16 16.83C15.64 16.76 16.64 16.23 16.85 15.65C17.06 15.07 17.06 14.57 17 14.47C16.94 14.37 16.82 14.45 16.57 14.33Z"/>
                    </svg>
                    <span>Consult on WhatsApp</span>
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>

    </div>
  </div>
</section>

---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { services } from '../data/services';
import { altFromFilename } from '../utils/altText';

import orthoImg from '@visuals/04_treatment_educational/braces-types-lingual-metal-ceramic-clear.jpg';
import rctImg from '@visuals/02_clinic_and_facilities/interior_and_equipment/nsk-endo-mate-dt-rotary-endodontic-motor.jpg';
import surgeryImg from '@visuals/03_doctor_and_team/dental-examination-instruments-procedure-closeup.jpg';
import prosthImg from '@visuals/02_clinic_and_facilities/interior_and_equipment/dental-chair-unit-side-view.jpg';
import cosmeticImg from '@visuals/03_doctor_and_team/dr-jyothi-sajjan-patient-consultation-desk.jpg';
import perioImg from '@visuals/02_clinic_and_facilities/interior_and_equipment/sterilization-room-autoclave-and-storage.jpg';
import pediatricImg from '@visuals/02_clinic_and_facilities/interior_and_equipment/treatment-operatory-green-chair-setup.jpg';

const serviceImages: Record<string, ImageMetadata> = {
  orthodontics: orthoImg,
  'root-canal': rctImg,
  'oral-surgery': surgeryImg,
  prosthodontics: prosthImg,
  cosmetic: cosmeticImg,
  periodontics: perioImg,
  pediatric: pediatricImg,
};
---

<section id="services" class="py-16 md:py-24">
  <div class="section-shell">
    <div class="reveal-on-scroll max-w-3xl">
      <h2 class="section-title">Core Services</h2>
      <p class="section-lead">
        Seven departments under one roof — from braces and root canals to implants, cosmetic care,
        and family dentistry.
      </p>
    </div>

    <div class="mt-10" x-data="{ active: 0, mobileOpen: -1 }">
      <div class="hidden lg:block">
        <div class="flex flex-wrap gap-2 border-b border-stone-200 pb-4" role="tablist">
          {
            services.map((service, index) => (
              <button
                type="button"
                role="tab"
                class="rounded-xl px-4 py-2.5 text-sm font-semibold transition"
                x-bind:class={`active === ${index} ? 'bg-brand text-white shadow-sm' : 'bg-white text-stone-700 hover:bg-stone-50'`}
                x-on:click={`active = ${index}`}
              >
                {service.title}
              </button>
            ))
          }
        </div>

        {
          services.map((service, index) => (
            <div
              role="tabpanel"
              class="mt-8 grid gap-8 lg:grid-cols-2"
              x-show={`active === ${index}`}
              x-cloak
            >
              <div class="card-surface card-hover p-6 md:p-8">
                <h3 class="text-xl font-bold text-stone-900">{service.title}</h3>
                <p class="mt-3 text-stone-600">{service.intro}</p>
                <ul class="mt-5 space-y-3 text-stone-700">
                  {service.items.map((item) => (
                    <li class="flex gap-2">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true" />
                      <span>
                        <strong>{item.name}</strong> — {item.description}
                      </span>
                    </li>
                  ))}
                </ul>
                {service.footer && <p class="mt-5 text-sm text-stone-600">{service.footer}</p>}
              </div>
              <div class="overflow-hidden rounded-2xl shadow-[var(--shadow-soft)]">
                <Image
                  src={serviceImages[service.id]}
                  alt={altFromFilename(service.imagePath.split('/').pop() ?? service.id)}
                  class="h-full min-h-[280px] w-full object-cover"
                  widths={[480, 640, 800]}
                  sizes="(max-width: 1024px) 100vw, 50vw"
                  loading="lazy"
                />
              </div>
            </div>
          ))
        }
      </div>

      <div class="space-y-3 lg:hidden">
        {
          services.map((service, index) => (
            <div class="card-surface overflow-hidden">
              <button
                type="button"
                class="flex w-full items-center justify-between px-5 py-4 text-left"
                x-on:click={`mobileOpen = mobileOpen === ${index} ? -1 : ${index}`}
                x-bind:aria-expanded={`mobileOpen === ${index}`}
              >
                <span class="font-semibold text-stone-900">{service.title}</span>
                <svg
                  class="h-5 w-5 text-stone-500 transition"
                  x-bind:class={`mobileOpen === ${index} ? 'rotate-180' : ''`}
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div x-show={`mobileOpen === ${index}`} x-cloak class="border-t border-stone-100 px-5 pb-5">
                <div class="overflow-hidden rounded-xl">
                  <Image
                    src={serviceImages[service.id]}
                    alt={altFromFilename(service.imagePath.split('/').pop() ?? service.id)}
                    class="aspect-video w-full object-cover"
                    widths={[480, 640]}
                    sizes="100vw"
                    loading="lazy"
                  />
                </div>
                <p class="mt-4 text-stone-600">{service.intro}</p>
                <ul class="mt-4 space-y-3 text-sm text-stone-700">
                  {service.items.map((item) => (
                    <li>
                      <strong>{item.name}</strong> — {item.description}
                    </li>
                  ))}
                </ul>
                {service.footer && <p class="mt-4 text-sm text-stone-600">{service.footer}</p>}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  [x-cloak] {
    display: none !important;
  }
</style>

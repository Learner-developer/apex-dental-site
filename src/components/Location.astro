---
import { address, hours, mapEmbedUrl, phoneDisplay, telUrl, whatsappUrl } from '../data/site';
---

<section id="location" class="bg-white py-20 md:py-28">
  <div class="section-shell">
    <div class="reveal-on-scroll max-w-2xl">
      <p class="eyebrow">Find us</p>
      <h2 class="section-title">Location, Map & Appointment</h2>
      <p class="section-lead">
        Serving Vidyaranyapura, MS Palya, Chickbetahalli, BHEL Layout, and Jalahalli East.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-stretch">
      <!-- Left Column: Visit & Contact Details -->
      <div class="lg:col-span-5">
        <div class="card-surface card-hover flex h-full flex-col justify-between border border-ink/10 p-6 md:p-8">
          <div>
            <h3 class="font-display text-2xl font-bold text-ink">Visit us</h3>
            <p class="mt-3 text-base leading-relaxed text-ink/75">{address}</p>

            <h3 class="mt-6 text-sm font-semibold uppercase tracking-[0.08em] text-brand-deep">Hours</h3>
            <div class="mt-3 grid grid-cols-2 gap-3">
              <div class="rounded-2xl bg-[#1de1da]/15 border border-[#1de1da]/25 p-4 transition-colors duration-200 hover:bg-[#1de1da]/25">
                <p class="text-xs font-semibold uppercase tracking-wide text-ink/60">Morning</p>
                <p class="mt-1 font-bold text-ink">{hours.morning}</p>
              </div>
              <div class="rounded-2xl bg-[#53ecc2]/20 border border-[#53ecc2]/30 p-4 transition-colors duration-200 hover:bg-[#53ecc2]/30">
                <p class="text-xs font-semibold uppercase tracking-wide text-ink/60">Evening</p>
                <p class="mt-1 font-bold text-ink">{hours.evening}</p>
              </div>
            </div>
            <p class="mt-3 text-sm font-medium text-ink/70">{hours.weekdays} · {hours.closed}</p>

            <h3 class="mt-6 text-sm font-semibold uppercase tracking-[0.08em] text-brand-deep">Phone</h3>
            <a href={telUrl} class="mt-2 inline-flex items-center gap-2 text-lg font-bold text-ink transition-all duration-200 hover:text-brand-deep hover:translate-x-1">
              <span>📞</span> {phoneDisplay}
            </a>
          </div>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-cta">
              Book on WhatsApp
            </a>
            <a href={telUrl} class="btn-ink">Call Now</a>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Map -->
      <div class="lg:col-span-7">
        <div class="card-hover h-full min-h-[460px] w-full overflow-hidden rounded-[1.5rem] border border-ink/10 bg-white shadow-[var(--shadow-soft)]">
          <iframe
            title="Apex Dental & Orthodontic Clinic on Google Maps"
            src={mapEmbedUrl}
            class="h-full min-h-[460px] w-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .font-display {
    font-family: var(--font-display);
  }
</style>

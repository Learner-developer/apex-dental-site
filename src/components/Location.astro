---
import { address, hours, mapEmbedUrl, phoneDisplay, telUrl, whatsappUrl } from '../data/site';
---

<section id="location" class="bg-white py-16 md:py-24">
  <div class="section-shell">
    <div class="reveal-on-scroll max-w-3xl">
      <h2 class="section-title">Location, Map & Appointment</h2>
      <p class="section-lead">
        Serving Vidyaranyapura, MS Palya, Chickbetahalli, BHEL Layout, and Jalahalli East.
      </p>
    </div>

    <div class="mt-10 grid gap-8 lg:grid-cols-2">
      <div class="card-surface p-6 md:p-8">
        <h3 class="text-lg font-bold text-stone-900">Visit us</h3>
        <p class="mt-3 leading-relaxed text-stone-600">{address}</p>

        <h3 class="mt-6 text-lg font-bold text-stone-900">Hours</h3>
        <ul class="mt-3 space-y-2 text-stone-600">
          <li>{hours.weekdays}</li>
          <li>Morning: {hours.morning}</li>
          <li>Evening: {hours.evening}</li>
          <li class="font-medium text-stone-800">{hours.closed}</li>
        </ul>

        <h3 class="mt-6 text-lg font-bold text-stone-900">Phone</h3>
        <a href={telUrl} class="mt-2 inline-block font-semibold text-brand-dark hover:underline">
          {phoneDisplay}
        </a>

        <div class="mt-8 flex flex-wrap gap-4">
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-cta">
            Book on WhatsApp
          </a>
          <a href={telUrl} class="btn-brand">Call Now</a>
        </div>
      </div>

      <div class="overflow-hidden rounded-2xl shadow-[var(--shadow-soft)]">
        <iframe
          title="Apex Dental & Orthodontic Clinic on Google Maps"
          src={mapEmbedUrl}
          class="h-full min-h-[360px] w-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</section>

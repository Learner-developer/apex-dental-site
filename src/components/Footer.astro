---
import { clinicName, hours, navLinks, phoneDisplay, tagline, telUrl } from '../data/site';
---

<footer class="border-t border-stone-200 bg-stone-900 py-12 text-stone-300">
  <div class="section-shell">
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <p class="text-lg font-bold text-white">{clinicName}</p>
        <p class="mt-2 text-sm">{tagline}</p>
      </div>

      <div>
        <p class="font-semibold text-white">Quick links</p>
        <ul class="mt-3 space-y-2 text-sm">
          {
            navLinks
              .filter((link) => link.label !== 'Gallery')
              .map((link) => (
                <li>
                  <a href={link.href} class="hover:text-white">
                    {link.label}
                  </a>
                </li>
              ))
          }
        </ul>
      </div>

      <div>
        <p class="font-semibold text-white">Contact</p>
        <p class="mt-3 text-sm">
          Mon-Sat, 9:30 AM-2 PM & 4:30-8:30 PM · Closed Sunday
        </p>
        <p class="mt-2 text-sm">
          <a href={telUrl} class="font-medium text-white hover:underline">
            {phoneDisplay}
          </a>
          · Vidyaranyapura, Bengaluru
        </p>
      </div>
    </div>

    <p class="mt-10 border-t border-stone-700 pt-6 text-center text-xs text-stone-500">
      © {new Date().getFullYear()} {clinicName}. All rights reserved.
    </p>
  </div>
</footer>

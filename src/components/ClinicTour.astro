---
import { Image } from 'astro:assets';
import { clinicTourItems, clinicTourFilters } from '../data/gallery';
import { altFromFilename } from '../utils/altText';
import { getVisualImage } from '../utils/images';

const tourImages = clinicTourItems.map((item) => getVisualImage(item.path || item.filename, 'clinic'));

const aspectRatios = [
  'aspect-[4/3]',
  'aspect-[3/4]',
  'aspect-[1/1]',
  'aspect-[16/10]',
  'aspect-[3/4]',
  'aspect-[4/3]',
  'aspect-[3/4]',
  'aspect-[16/10]',
  'aspect-[1/1]',
  'aspect-[3/4]',
  'aspect-[4/3]',
  'aspect-[3/4]',
];

const tourData = clinicTourItems.map((item, index) => ({
  ...item,
  index,
  alt: altFromFilename(item.filename),
  aspectRatio: aspectRatios[index] || 'aspect-[4/3]',
}));
---

<section id="gallery" class="relative overflow-hidden bg-cream py-16 sm:py-24 md:py-28">
  <div
    class="blob-shape blob-float pointer-events-none absolute -left-20 top-24 hidden h-80 w-80 bg-[#38bdf8]/15 blur-2xl lg:block"
    aria-hidden="true"
  ></div>
  <div
    class="blob-shape-alt blob-float-slow pointer-events-none absolute -right-16 bottom-16 hidden h-72 w-72 bg-[#c084fc]/15 blur-2xl lg:block"
    aria-hidden="true"
  ></div>

  <div
    class="section-shell relative"
    x-data={`{
      filter: 'all',
      showAll: false,
      lightbox: null,
      total: ${tourData.length},
      touchStartX: 0,
      touchEndX: 0,
      openLightbox(index) {
        this.lightbox = index;
        document.body.style.overflow = 'hidden';
      },
      closeLightbox() {
        this.lightbox = null;
        document.body.style.overflow = '';
      },
      next() {
        if (this.lightbox !== null) {
          this.lightbox = (this.lightbox + 1) % this.total;
        }
      },
      prev() {
        if (this.lightbox !== null) {
          this.lightbox = (this.lightbox - 1 + this.total) % this.total;
        }
      },
      handleTouchStart(e) {
        this.touchStartX = e.changedTouches[0].screenX;
      },
      handleTouchEnd(e) {
        this.touchEndX = e.changedTouches[0].screenX;
        if (this.touchStartX - this.touchEndX > 40) {
          this.next();
        } else if (this.touchEndX - this.touchStartX > 40) {
          this.prev();
        }
      }
    }`}
    @keydown.escape.window="closeLightbox()"
    @keydown.arrow-right.window="if (lightbox !== null) next()"
    @keydown.arrow-left.window="if (lightbox !== null) prev()"
  >
    <!-- Section Header -->
    <div class="reveal-on-scroll max-w-2xl">
      <p class="eyebrow text-[#f59e0b]">Inside the clinic</p>
      <h2 class="section-title">Clinic & Technology Tour</h2>
      <p class="section-lead">
        Modern operatories, on-site digital imaging, rotary endodontics, and a dedicated sterilization
        bay — see the clinic before you visit.
      </p>
    </div>

    <!-- Category Filter Chips -->
    <div class="mt-8 flex flex-wrap items-center gap-2 sm:gap-2.5" role="tablist" aria-label="Clinic Tour Filters">
      {
        clinicTourFilters.map((chip) => (
          <button
            type="button"
            class="rounded-full px-4 py-2 text-xs sm:text-sm font-semibold tracking-wide transition-all duration-200 cursor-pointer active:scale-95 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
            :class={`filter === '${chip.id}' ? 'bg-ink text-white shadow-sm border border-ink' : 'bg-white border border-ink/10 text-ink hover:bg-[#38bdf8]/15 hover:border-[#38bdf8]/60'`}
            @click={`filter = '${chip.id}'; showAll = false;`}
            role="tab"
            :aria-selected={`filter === '${chip.id}'`}
          >
            {chip.label}
          </button>
        ))
      }
    </div>

    <!-- Masonry Editorial Grid (2 Rows Initially, Compact Sizing, Full-Width Bottom Blurred Hover) -->
    <div class="mt-8 sm:mt-10 columns-2 sm:columns-3 lg:columns-4 gap-2.5 sm:gap-3">
      {
        tourData.map((item) => (
          <div
            class="break-inside-avoid mb-2.5 sm:mb-3 block"
            x-show={`(showAll || ${item.index} < 8 || filter !== 'all') && (filter === 'all' || filter === '${item.category}')`}
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0 scale-95"
            x-transition:enter-end="opacity-100 scale-100"
          >
            <button
              type="button"
              class="group relative w-full block overflow-hidden rounded-none border-0 bg-ink-soft/5 transition-all duration-300 ease-out text-left cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
              @click={`openLightbox(${item.index})`}
              aria-label={`View photo: ${item.title}`}
            >
              <!-- Sharp Corner Image Container -->
              <div class={`relative w-full ${item.aspectRatio} overflow-hidden rounded-none bg-ink/10`}>
                <Image
                  src={tourImages[item.index]}
                  alt={item.alt}
                  class="h-full w-full rounded-none object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                  widths={[320, 500, 800]}
                  sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw"
                  loading="lazy"
                />

                <!-- Full-Width Bottom Hover Overlay (Translucent with Blurred Background) -->
                <div class="absolute inset-x-0 bottom-0 z-10 w-full transform translate-y-full opacity-0 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100 transition-all duration-300 ease-out">
                  <div class="w-full bg-ink/75 backdrop-blur-md border-t border-white/10 px-3.5 py-3 sm:px-4 sm:py-3.5 text-white">
                    <h3 class="font-display text-xs sm:text-sm font-bold text-white tracking-tight leading-snug">
                      {item.title}
                    </h3>
                    <p class="mt-0.5 font-sans text-[11px] sm:text-xs leading-relaxed text-white/85 line-clamp-2">
                      {item.caption}
                    </p>
                  </div>
                </div>

                <!-- Mobile static minimal bottom scrim -->
                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/85 via-ink/40 to-transparent p-2 sm:hidden text-white">
                  <p class="text-[11px] font-bold text-white leading-tight line-clamp-1">{item.title}</p>
                </div>
              </div>
            </button>
          </div>
        ))
      }
    </div>

    <!-- More / Less Button -->
    <div class="mt-8 sm:mt-10 flex justify-center" x-show="filter === 'all'">
      <button
        type="button"
        class="inline-flex items-center gap-2 rounded-full border border-ink/15 bg-white px-6 py-3 text-sm font-semibold tracking-wide text-ink shadow-sm transition duration-200 ease-out hover:-translate-y-0.5 hover:border-ink hover:bg-ink hover:text-white hover:shadow-md active:translate-y-0 active:scale-95 cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand"
        @click="showAll = !showAll"
        x-show="!showAll"
      >
        <span>View All Clinic Photos (12)</span>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      <button
        type="button"
        class="inline-flex items-center gap-2 rounded-full border border-ink/15 bg-white px-6 py-3 text-sm font-semibold tracking-wide text-ink shadow-sm transition duration-200 ease-out hover:-translate-y-0.5 hover:border-ink hover:bg-ink hover:text-white hover:shadow-md active:translate-y-0 active:scale-95 cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand"
        @click="showAll = false"
        x-show="showAll"
        x-cloak
      >
        <span>Show Less</span>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
        </svg>
      </button>
    </div>

    <!-- Minimal Lightbox Modal Image Viewer (Frosted Blur Background like Sticky Menu Bar) -->
    <div
      class="fixed inset-0 z-[100] flex flex-col items-center justify-center p-4 sm:p-8 bg-ink/75 backdrop-blur-2xl"
      style="-webkit-backdrop-filter: blur(16px) saturate(180%); backdrop-filter: blur(16px) saturate(180%);"
      x-show="lightbox !== null"
      x-cloak
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      @click.self="closeLightbox()"
      @touchstart.passive="handleTouchStart($event)"
      @touchend.passive="handleTouchEnd($event)"
      role="dialog"
      aria-modal="true"
      aria-label="Clinic photo gallery viewer"
    >
      <!-- Minimal Close Button in Top Right -->
      <button
        type="button"
        class="absolute right-4 top-4 sm:right-6 sm:top-6 z-30 inline-flex h-10 w-10 items-center justify-center rounded-full text-white/75 hover:text-white hover:bg-white/10 transition duration-200 cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand"
        @click="closeLightbox()"
        aria-label="Close image viewer"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Left Arrow -->
      <button
        type="button"
        class="absolute left-3 sm:left-6 z-20 inline-flex h-12 w-12 sm:h-14 sm:w-14 items-center justify-center text-white/75 hover:text-white hover:scale-110 active:scale-95 transition duration-200 cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand"
        @click="prev()"
        aria-label="Previous photo"
      >
        <svg class="h-8 w-8 sm:h-10 sm:w-10 drop-shadow-md" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Right Arrow -->
      <button
        type="button"
        class="absolute right-3 sm:right-6 z-20 inline-flex h-12 w-12 sm:h-14 sm:w-14 items-center justify-center text-white/75 hover:text-white hover:scale-110 active:scale-95 transition duration-200 cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand"
        @click="next()"
        aria-label="Next photo"
      >
        <svg class="h-8 w-8 sm:h-10 sm:w-10 drop-shadow-md" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Main Image & Content Below Only -->
      <div class="relative flex flex-col items-center justify-center max-w-4xl w-full select-none" @click.stop>
        {
          tourData.map((item) => (
            <div
              x-show={`lightbox === ${item.index}`}
              x-cloak
              class="flex flex-col items-center justify-center w-full"
            >
              <!-- Sharp Corner Photo -->
              <Image
                src={tourImages[item.index]}
                alt={item.alt}
                class="max-h-[68vh] sm:max-h-[72vh] w-auto max-w-full rounded-none object-contain shadow-2xl"
                widths={[800, 1200, 1600]}
                sizes="(max-width: 1024px) 90vw, 1200px"
                loading="lazy"
              />

              <!-- Content Below Image Only -->
              <div class="mt-4 sm:mt-5 text-center max-w-2xl px-4">
                <h3 class="font-display text-base sm:text-lg font-bold text-white tracking-tight text-pretty">
                  {item.title}
                </h3>
                <p class="mt-1 font-sans text-xs sm:text-sm text-white/85 leading-relaxed text-pretty">
                  {item.caption}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  [x-cloak] {
    display: none !important;
  }
</style>
